# 动态版运行参数（示例；不要提交真实密码）
# 生产：<DATA_DIR>/blog.db
BLOG_DB_PATH=./data/blog.db
# 生产：<DATA_DIR>/uploads
BLOG_UPLOAD_DIR=./data/uploads
# 只在数据库里还没有用户时用来播种第一个管理员
BLOG_ADMIN_USER=admin
BLOG_ADMIN_PASSWORD=change-me-before-first-boot
# 是否信任 CDN 专有客户端 IP 头（CF-Connecting-IP / Ali-CDN-Real-IP 等）
# 仅在源站防火墙已限制只允许 CDN 回源 IP 段访问时设为 1，默认 0 防伪造
BLOG_TRUST_CDN_HEADERS=0
# 额外不写入访客统计的 IP / IPv4 CIDR（逗号、空格或换行分隔；改动后重启服务）
# 已知批量爬虫已内置在 src/server/bot-ip-rules.ts，这里用于以后补充
BLOG_BOT_IP_RULES=

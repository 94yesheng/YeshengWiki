# Apache 配置 —— 随构建产物一起部署到网站根目录
#
# 全部指令都包在 <IfModule> 里：共享虚拟主机不保证开了某个模块，而写了模块尚未
# 启用的指令会让整个站点 500。用 IfModule 包起来，模块没开就跳过，站点照常跑。

# ---------------------------------------------------------------------------
# 1) 目录索引：让 /posts/ 这类目录路径正确落到 index.html
#    （astro.config.mjs 用了 build.format: 'directory'，就是为这个准备的）
# ---------------------------------------------------------------------------
DirectoryIndex index.html index.htm

# 关掉目录列表：否则别人访问 /_astro/ 就能像文件管理器一样翻你的文件
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# ---------------------------------------------------------------------------
# 2) 强制 HTTPS
#
# **启用前必须先确认 cPanel 里 SSL 证书已经签好**，否则站点会打不开。
# 确认之后，把下面三行的 # 去掉即可。
# ---------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# ---------------------------------------------------------------------------
# 3) 压缩：文本类资源传之前先压
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 4) 缓存
#
# dist/_astro/ 下的文件名带内容哈希（如 blender-01.Cbc5D77H.webp），内容一变文件名
# 就变，所以可以放心让浏览器永久缓存 —— 这是静态站省带宽最有效的一招。
# HTML 则相反，必须每次问服务器，否则你发了新文章访客看不到。
# 注意：/admin/ 下的东西不缓存，避免后台更新后浏览器还拿着旧版本。
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # 带哈希的静态资源与字体：一年
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"

  # 页面与订阅文件：不缓存
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType application/rss+xml     "access plus 0 seconds"
  ExpiresByType application/xml         "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # 哈希资源是不可变的，明确告诉浏览器
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 5) 补充 MIME 类型（个别老主机不带 woff2 映射，缺了会导致字体加载失败）
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

# ---------------------------------------------------------------------------
# 6) 顺手挡掉几个常见的扫描路径，减少日志噪音（不是安全防线，只是降噪）
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-content) - [R=404,L]
</IfModule>

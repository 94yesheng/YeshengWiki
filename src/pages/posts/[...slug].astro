---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, type Post } from '../../utils/posts';
import { chineseFullDate, readingTime } from '../../utils/date';
import { cjkSpacing } from '../../utils/typography';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    // 用 [...slug] 而不是 [slug]，这样以后文章放进子目录也能对上。
    // 个别情况下 id 会带着 .md 后缀，这里统一剥掉。
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { chars, minutes } = readingTime(post.body ?? '');
const tags = post.data.tags;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="wrap article">
    <header class="article-head">
      <p class="dateline">{chineseFullDate(post.data.pubDate)}</p>
      <h1 class="article-title">{cjkSpacing(post.data.title)}</h1>
    </header>

    <div class="article-body">
      {/*
        左侧元信息栏 —— 桌面版式里这些"次要但常看"的信息放边上，
        正文就能独占右边一整栏、不再被压成手机那样的窄条。
        它是 sticky 的：长文往下滚时字数/标签一直看得见，不会滚没。
      */}
      <aside class="article-rail">
        <div class="rail-block">
          <p class="rail-k">字数</p>
          <p class="rail-v">{chars} 字</p>
        </div>
        <div class="rail-block">
          <p class="rail-k">阅读</p>
          <p class="rail-v">约 {minutes} 分钟</p>
        </div>
        {
          post.data.updatedDate && (
            <div class="rail-block">
              <p class="rail-k">修订</p>
              <p class="rail-v">{chineseFullDate(post.data.updatedDate)}</p>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="rail-block">
              <p class="rail-k">标签</p>
              <p class="rail-v">{tags.join(' · ')}</p>
            </div>
          )
        }
        <nav class="article-end">
          <a href="/posts/">← 全部文章</a>
        </nav>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* 容器宽度用 .wrap 默认的 --shell（64rem）—— 不再卡回阅读宽。
     选择器仍写成 .wrap.article（两个类）是为了稳赢 base.css 里的 .wrap，
     不依赖样式注入顺序 */
  .wrap.article {
    padding-top: var(--space-7);
  }

  /* 题头：一条短朱红横线领着日期，和列表页的日期栏呼应 */
  .dateline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-family: var(--kai);
    font-size: var(--text-sm);
    letter-spacing: 0.18em;
    color: var(--seal);
  }

  .dateline::before {
    content: "";
    width: 2.25rem;
    height: 1px;
    background: var(--seal);
    flex: none;
  }

  .article-title {
    margin: 0 0 var(--space-6);
    font-family: var(--kai);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  /* ---------- 两栏 ---------- */

  .article-body {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: var(--space-8);
    /* 必须是 start：左栏拉满整列高度的话，sticky 就没有可粘的余地了 */
    align-items: start;
  }

  .article-rail {
    position: sticky;
    /* 顶栏是粘顶的，所以左栏要粘在它**下面**，不是 0 */
    top: calc(var(--nav-h) + var(--space-5));
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-2);
  }

  .rail-block { margin: 0; }

  .rail-k {
    margin: 0 0 0.25em;
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    color: var(--rule);
  }

  .rail-v {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--muted);
  }

  .article-end {
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
  }

  .article-end a {
    color: var(--muted);
    transition: color var(--dur-fast) ease;
  }

  .article-end a:hover { color: var(--seal); }

  /* 窄屏塌成一栏（不专门做手机适配，只是别挤爆） */
  @media (max-width: 34rem) {
    .article-body { grid-template-columns: 1fr; gap: var(--space-6); }
    .article-rail { position: static; flex-direction: row; flex-wrap: wrap; gap: var(--space-5); }
    .article-title { font-size: var(--text-xl); }
  }
</style>

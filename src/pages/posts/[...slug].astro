---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, type Post } from '../../utils/posts';
import { chineseFullDate, readingTime } from '../../utils/date';
import { cjkSpacing } from '../../utils/typography';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    // 用 [...slug] 而不是 [slug]，这样以后文章放进子目录也能对上。
    // 个别情况下 id 会带着 .md 后缀，这里统一剥掉。
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { chars, minutes } = readingTime(post.body ?? '');
const tags = post.data.tags;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <header class="article-head">
      <p class="dateline">{chineseFullDate(post.data.pubDate)}</p>
      <h1 class="article-title">{cjkSpacing(post.data.title)}</h1>
    </header>

    <div class="article-body">
      {/*
        左侧元信息栏 —— 桌面版式里这些"次要但常看"的信息放边上，
        正文就能独占右边一整栏、不再被压成手机那样的窄条。
        它是 sticky 的：长文往下滚时字数/标签一直看得见，不会滚没。
      */}
      <aside class="article-rail">
        <div class="rail-block">
          <p class="rail-k">字数</p>
          <p class="rail-v">{chars} 字</p>
        </div>
        <div class="rail-block">
          <p class="rail-k">阅读</p>
          <p class="rail-v">约 {minutes} 分钟</p>
        </div>
        {
          post.data.updatedDate && (
            <div class="rail-block">
              <p class="rail-k">修订</p>
              <p class="rail-v">{chineseFullDate(post.data.updatedDate)}</p>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="rail-block">
              <p class="rail-k">标签</p>
              <p class="rail-v">{tags.join(' · ')}</p>
            </div>
          )
        }
        <nav class="article-end">
          <a href="/posts/">← 全部文章</a>
        </nav>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* 这一页不再整体套 .wrap：正文区要**铺满整个视口宽**，
     左栏才有地方挪到两侧的空白里去。题头自己定宽（见下），和正文列对齐 */
  .article { padding-top: var(--space-7); }

  /* 题头和正文**同宽**（50rem）—— 这样两侧的竖线才能把标题和正文一起框住。
     只加内边距是为了窄屏下不贴边；宽屏时内边距之外正好是 50rem */
  .article-head {
    max-width: calc(50rem + 2 * var(--pad-x));
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  /* 题头：一条短强调色横线领着日期，和列表页的日期栏呼应 */
  .dateline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-family: var(--kai);
    font-size: var(--text-sm);
    letter-spacing: 0.18em;
    color: var(--accent);
  }

  .dateline::before {
    content: "";
    width: 2.25rem;
    height: 1px;
    background: var(--accent);
    flex: none;
  }

  .article-title {
    margin: 0 0 var(--space-6);
    font-family: var(--kai);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  /* ---------- 正文与左栏 ----------
     默认（屏幕不够宽）：左栏和正文并排，都待在 64rem 容器里。
     屏幕够宽时换成下面那套：正文真正居中、左栏挪到左侧空白里。 */
  .article-body {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0 var(--space-7);
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 var(--pad-x);
    /* 必须是 start：左栏拉满整列高度的话，sticky 就没有可粘的余地了 */
    align-items: start;
    /* 两侧竖线的定位基准。放在这一层（而不是 .article 上）是有意的：
       竖线要**从标题以下才开始**，而 .article 把题头也包在里面 */
    position: relative;
  }

  .article-rail {
    grid-column: 1;
    position: sticky;
    /* 顶栏是粘顶的，所以左栏要粘在它**下面**，不是 0 */
    top: calc(var(--nav-h) + var(--space-5));
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-2);
  }

  /* 宽屏：三列 minmax(0,1fr) / 正文 / minmax(0,1fr) ——
     左右两个 1fr 必然相等，所以正文那一列是**真正居中**的；
     左栏 justify-self:end 塞进左边那片空白。
     【88rem 这个断点是怎么来的】左栏要塞进"屏幕左边留 1.5rem 余地"到
     "标题左边线再退 2rem 空隙"之间，于是：
       宽度 ≥ 2 × (左栏 10rem + 标题间隙 2rem + 31.5rem + 1.5rem) = 90rem，
     再扣掉滚动条那 15px 的实际损耗，落回 88rem。
     比这窄就放不下（左栏会被挤出屏幕左边裁掉），退回上面那套并排版式。
     ⚠️ 别把这个断点卡到"刚好放得下"：实测媒体查询的取值宽度和 clientWidth
     能差一个滚动条（iframe 里差 15px），留点余量。 */
  @media (min-width: 88rem) {
    .article-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 50rem) minmax(0, 1fr);
      gap: 0 var(--space-8);
      max-width: none;
    }

    .article-rail {
      grid-column: 1;
      justify-self: end;   /* 贴到左边那片空白的右缘 */
      /* 10rem：够放下"技术 · 服务器"这类值；万一有"修订"日期（十个字）会折成两行，
         可接受。这个宽度直接决定上面的断点，改它要回去重算 */
      width: 10rem;
      /* 再往左推 3rem —— 正文加宽到 50rem 之后，左栏右边线本来就只差 1rem
         就压到标题的左边线了；推 1rem 抵消它、再推 2rem 做空隙，合起来 3rem。
         用户要的就是"最右端离标题最左端要有一些空隙" */
      margin-right: 3rem;
    }

    /* 正文落在中间那一列；min-width:0 免得长代码行把网格撑宽、把居中位置带偏 */
    .article-body > .prose {
      grid-column: 2;
      min-width: 0;
    }

    /* 正文两侧那两条竖线。
       位置 = 视口中心 ± 30rem —— 正文半宽是 25rem，所以线离正文 5rem（80px）、
       离左栏的右缘只剩 2.5rem。用户要的就是"离文章远一点、靠近元信息栏"。
       从标题**以下**才开始（挂在 .article-body 上，不在 .article 上），
       所以标题和日期是在两条线之外的。

       用绝对定位而不是 border：这两条线要跨过好几个块（正文里有图、有引用、
       有分隔符），border 只能贴在某一个盒子上。
       只在宽屏版式里画 —— 窄屏那套正文不是 50rem 居中，线会穿进正文里。 */
    .article-body::before,
    .article-body::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--rule);   /* 最淡的一档，就是"不太明显" */
    }

    .article-body::before { left: calc(50% - 30rem); }
    .article-body::after { right: calc(50% - 30rem); }
  }

  .rail-block { margin: 0; }

  .rail-k {
    margin: 0 0 0.25em;
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    color: var(--faint);
  }

  .rail-v {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--muted);
  }

  .article-end {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
  }

  /* 分割线：不用 border-top（那会撑满整个左栏，比下面的文字宽出一大截），
     改成一条固定 4rem 的短线，跟"← 全部文章"这几个字同量级 */
  .article-end::before {
    content: "";
    display: block;
    width: 4rem;
    height: 1px;
    margin-bottom: var(--space-4);
    background: var(--rule);
  }

  .article-end a {
    color: var(--muted);
    transition: color var(--dur-fast) ease;
  }

  .article-end a:hover { color: var(--accent); }

  /* 窄屏塌成一栏（不专门做手机适配，只是别挤爆） */
  @media (max-width: 34rem) {
    .article-body { grid-template-columns: 1fr; gap: var(--space-6); }
    .article-rail {
      grid-column: 1;
      justify-self: stretch;
      width: auto;
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-5);
    }
    .article-title { font-size: var(--text-xl); }
  }
</style>

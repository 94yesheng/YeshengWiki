---
/**
 * 文章页 —— artifact 版。
 *
 * 骨架来自 code_artifact.html 的 #article-view（原样切出，见 scripts/import-artifact.mjs），
 * 正文换成 Astro 的 <Content />，标题/日期/标签/字数/目录/上下篇/右栏由这里注入。
 *
 * 【几个必须记住的约定】
 * · 模板里用 @@NAME@@ 占位符；替换一律 split/join（避免 $& 被 String.replace 当替换模式）。
 * · @@PROSE@@ 是正文插入点：前面那段以 <div class="article-prose-q"> 结尾、
 *   后面那段以 </div> 开头，所以 <Content /> 必须**直接**夹在两个 Fragment 之间，
 *   不能额外包一层 div，否则会破坏 .article-workspace-grid 的网格上下文。
 * · 现有 5 篇正文没有 Markdown 标题（小标题都是 **加粗**），所以 headings 是空的 ——
 *   TOC 显示空态提示，不伪造目录。
 */
import { render } from 'astro:content';
import ArtifactLayout from '../../layouts/ArtifactLayout.astro';
import articleTpl from '../../artifact/article.html?raw';
import railTopology from '../../artifact/rail-topology.html?raw';
import railSpec from '../../artifact/rail-spec.html?raw';
import { getPublishedPosts, getPostLead } from '../../utils/posts';
import type { Post } from '../../utils/posts';
import { chineseFullDate, readingTime } from '../../utils/date';
import { cjkSpacing } from '../../utils/typography';
import '../../styles/artifact-prose.css';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };

const posts = await getPublishedPosts();
const { Content, headings } = await render(post);
const { chars, minutes } = readingTime(post.body ?? '');

const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : null; // 数组是 pubDate 倒序
const older = index < posts.length - 1 ? posts[index + 1] : null;

const title = cjkSpacing(post.data.title);
const tags = post.data.tags;
const tagText = tags.length ? tags.join(' · ') : '未分类';
const lead = getPostLead(post);
const dateText = chineseFullDate(post.data.pubDate);
const entryNo = String(index + 1).padStart(2, '0');

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

/* ---------- TOC ---------- */
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const tocHtml = toc.length
  ? `<ul class="toc-list" id="article-toc-list">${toc
      .map(
        (h, i) =>
          `<li><a href="#${h.slug}"><span class="toc-num">${String(i + 1).padStart(
            2,
            '0'
          )}</span><span>${esc(h.text)}</span></a></li>`
      )
      .join('')}</ul>`
  : `<p class="toc-empty">本文未设置小节标题</p>`;

/* ---------- 相关文章 ---------- */
const related = posts.filter((p) => p.id !== post.id).slice(0, 4);
const relatedHtml = `<ul class="rail-related-list">${related
  .map((p) => {
    const n = String(posts.findIndex((x) => x.id === p.id) + 1).padStart(2, '0');
    const cat = p.data.tags[0] ?? 'ARCHIVE';
    return `<li><a href="/posts/${p.id}/"><span class="r-idx">ENTRY #${n} // ${esc(
      cat
    )}</span><span class="r-tit">${esc(cjkSpacing(p.data.title))}</span></a></li>`;
  })
  .join('')}</ul>`;

/* ---------- 上一篇 / 下一篇 ---------- */
const pagerCell = (p: Post | null, dir: 'prev' | 'next') => {
  const label = dir === 'prev' ? '&lt;- PREV ENTRY' : 'NEXT ENTRY -&gt;';
  const href = p ? `/posts/${p.id}/` : '/posts/';
  const text = p ? esc(cjkSpacing(p.data.title)) : '全部文章';
  return `<a class="article-pager-cell" href="${href}"><span class="pager-kicker">${label}</span><span class="pager-title">${text}</span></a>`;
};
const pagerHtml = `<div class="article-pager-grid">${pagerCell(
  newer,
  'prev'
)}${pagerCell(older, 'next')}</div>`;

/* ---------- 右栏 ---------- */
const isMc = post.id === 'mc-server';
const genericRail = `<div class="rail-blueprint-card">
  <div class="rail-card-kicker"><span>DOC SPEC // 文档速查卡</span><span>BASELINE</span></div>
  <ul class="rail-kv-list">
    <li><span>PUBLISHED</span><strong>${esc(dateText)}</strong></li>
    <li><span>CHARS</span><strong>${chars.toLocaleString('zh-CN')} 字</strong></li>
    <li><span>READING</span><strong>约 ${minutes} 分钟</strong></li>
    <li><span>TAGS</span><strong>${esc(tagText)}</strong></li>
  </ul>
</div>`;

/* ---------- 注入 ---------- */
const slots: Record<string, string> = {
  TOPBAR_TITLE: esc(`/posts/${post.id}/ · ${title}`),
  ENTRY_NO: entryNo,
  TITLE: esc(title),
  LEAD: esc(lead),
  DATE: esc(dateText),
  TAGS: esc(tagText),
  WORDS: `约 ${chars.toLocaleString('zh-CN')} 字`,
  READING: `约 ${minutes} 分钟`,
  KICKER: `ARCHIVE COORDINATE // ENTRY #${entryNo}`,
  // 注意：这个值会进 HTML，尖括号必须写成实体，否则会被当标签解析
  KINETIC_CAPTION: isMc ? 'LOCAL : 25565 &lt;-&gt; FRP' : 'LOCAL : STATIC BUILD',
  TOC: tocHtml,
  RAIL_TOPOLOGY: isMc ? railTopology : genericRail,
  RAIL_SPEC: isMc ? railSpec : '',
  RAIL_RELATED: relatedHtml,
  PAGER: pagerHtml,
};

let html = articleTpl;
for (const [key, value] of Object.entries(slots)) {
  const token = `@@${key}@@`;
  if (!html.includes(token)) console.warn('[article] 缺占位符', token);
  html = html.split(token).join(value);
}

const [before, after] = html.split('@@PROSE@@');
if (after === undefined) throw new Error('article.html 缺少 @@PROSE@@ 占位符');
---

<ArtifactLayout
  page="article"
  bodyClass="article"
  title={post.data.title}
  description={post.data.description}
>
  <Fragment set:html={before} />
  <Content />
  <Fragment set:html={after} />
</ArtifactLayout>

---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, type Post } from '../../utils/posts';
import { chineseFullDate, readingTime } from '../../utils/date';
import { cjkSpacing } from '../../utils/typography';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    // 用 [...slug] 而不是 [slug]，这样以后文章放进子目录也能对上。
    // 个别情况下 id 会带着 .md 后缀，这里统一剥掉。
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { chars, minutes } = readingTime(post.body ?? '');
const tags = post.data.tags;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <header class="article-head wrap">
      <p class="dateline">{chineseFullDate(post.data.pubDate)}</p>
      <h1 class="article-title">{cjkSpacing(post.data.title)}</h1>
    </header>

    <div class="article-body">
      {/*
        左侧元信息栏 —— 桌面版式里这些"次要但常看"的信息放边上，
        正文就能独占右边一整栏、不再被压成手机那样的窄条。
        它是 sticky 的：长文往下滚时字数/标签一直看得见，不会滚没。
      */}
      <aside class="article-rail">
        <div class="rail-block">
          <p class="rail-k">字数</p>
          <p class="rail-v">{chars} 字</p>
        </div>
        <div class="rail-block">
          <p class="rail-k">阅读</p>
          <p class="rail-v">约 {minutes} 分钟</p>
        </div>
        {
          post.data.updatedDate && (
            <div class="rail-block">
              <p class="rail-k">修订</p>
              <p class="rail-v">{chineseFullDate(post.data.updatedDate)}</p>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="rail-block">
              <p class="rail-k">标签</p>
              <p class="rail-v">{tags.join(' · ')}</p>
            </div>
          )
        }
        <nav class="article-end">
          <a href="/posts/">← 全部文章</a>
        </nav>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* 这一页不再整体套 .wrap：题头留在 .wrap 里（占满 64rem），
     正文区要**铺满整个视口宽**，这样左栏才有地方挪到两侧的空白里去 */
  .article { padding-top: var(--space-7); }

  /* 题头：一条短朱红横线领着日期，和列表页的日期栏呼应 */
  .dateline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-family: var(--kai);
    font-size: var(--text-sm);
    letter-spacing: 0.18em;
    color: var(--seal);
  }

  .dateline::before {
    content: "";
    width: 2.25rem;
    height: 1px;
    background: var(--seal);
    flex: none;
  }

  .article-title {
    margin: 0 0 var(--space-6);
    font-family: var(--kai);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  /* ---------- 正文居中，左栏在两侧空白里 ----------
     三列 1fr / 正文 / 1fr：正文那一列居中（左右两个 1fr 必然相等），
     左栏塞进左边那片空白、贴着正文的左边停住。这样正文是活动的阅读列，
     元信息落在它外侧的留白中，不再和正文挤在同一行里。 */
  .article-body {
    display: grid;
    grid-template-columns: 1fr minmax(0, 40rem) 1fr;
    gap: 0 var(--space-8);
    padding: 0 var(--pad-x);
    /* 必须是 start：左栏拉满整列高度的话，sticky 就没有可粘的余地了 */
    align-items: start;
  }

  .article-rail {
    grid-column: 1;
    justify-self: end;   /* 贴到左边那片空白的右缘 */
    width: 15rem;
    position: sticky;
    /* 顶栏是粘顶的，所以左栏要粘在它**下面**，不是 0 */
    top: calc(var(--nav-h) + var(--space-5));
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-2);
  }

  /* 正文落在中间那一列；min-width:0 免得长代码行把网格撑宽、把居中位置带偏 */
  .article-body > .prose {
    grid-column: 2;
    min-width: 0;
  }

  .rail-block { margin: 0; }

  .rail-k {
    margin: 0 0 0.25em;
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    color: var(--faint);
  }

  .rail-v {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--muted);
  }

  .article-end {
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
  }

  .article-end a {
    color: var(--muted);
    transition: color var(--dur-fast) ease;
  }

  .article-end a:hover { color: var(--seal); }

  /* 窄屏塌成一栏（不专门做手机适配，只是别挤爆） */
  @media (max-width: 34rem) {
    .article-body { grid-template-columns: 1fr; gap: var(--space-6); }
    .article-rail {
      grid-column: 1;
      justify-self: stretch;
      width: auto;
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-5);
    }
    .article-title { font-size: var(--text-xl); }
  }
</style>

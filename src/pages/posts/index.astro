---
/**
 * 文章归档子页 —— artifact 版（第二层：时间轴归档 + 标签/关键词筛选）。
 *
 * 模板由 scripts/import-artifact.mjs 从 demo/code_artifact (1).html 切出：
 * 原文的页内视图切换已改成真实路由，文章条目直接指向 /posts/<slug>/。
 */
import ArtifactLayout from '../../layouts/ArtifactLayout.astro';
import postsTpl from '../../artifact/posts.html?raw';
---

<ArtifactLayout
  page="posts"
  bodyClass="home"
  title="文章"
  description="按时间从近及远排列的全部文章，支持标签筛选与关键词检索。"
>
  <Fragment set:html={postsTpl} />
</ArtifactLayout>

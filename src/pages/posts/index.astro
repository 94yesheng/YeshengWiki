---
/**
 * 文章归档子页 —— SSR 版。
 * 时间轴、标签计数、统计、首屏文案和右栏快跳全部由 SQLite 动态生成；
 * 当文章未设置封面时，右侧不显示封面缩略图，将文章梗概的文字栏直接横向拉伸至原来有封面的位置。
 */
export const prerender = false;

import ArtifactLayout from '../../layouts/ArtifactLayout.astro';
import postsTpl from '../../artifact/posts.html?raw';
import { listPosts, type Post } from '../../server/repositories/posts';
import { copy, getPageValues } from '../../server/pages';
import { applyArtifactSite, getSiteConfig } from '../../server/site';
import { groupByYearMonth } from '../../utils/timeline';
import { chineseDay, chineseMonth, chineseYear, readingTime } from '../../utils/date';
import { cjkSpacing } from '../../utils/typography';

const posts = listPosts();
const total = posts.length;
const site = getSiteConfig();
const pages = getPageValues();
const c = (key: string, vars?: Record<string, string | number>) => copy(pages, key, vars);

const MONTH_EN = [
  'JANUARY',
  'FEBRUARY',
  'MARCH',
  'APRIL',
  'MAY',
  'JUNE',
  'JULY',
  'AUGUST',
  'SEPTEMBER',
  'OCTOBER',
  'NOVEMBER',
  'DECEMBER',
];

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const pad2 = (n: number) => String(n).padStart(2, '0');

const DESIGN_BADGES: Record<string, string> = {
  'mc-server': 'LATEST',
  'ji-bao': 'ESSAY',
  maptoposter: 'TOOLKIT',
  blender: '3D MESH',
  'deepseek-wechat': 'LLM BRIDGE',
};

function coverFor(post: Post): string {
  return post.cover?.trim() || '';
}

function leadFor(post: Post): string {
  if (post.lead?.trim()) return post.lead.trim();
  const text = post.bodyMarkdown
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/<[^>]+>/g, '')
    .replace(/[*_`#>~-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (text.length > 110) return `${text.slice(0, 110)}…`;
  return text || post.description || '';
}

const entryNo = new Map<string, number>();
posts.forEach((post, i) => entryNo.set(post.slug, i + 1));

const years = groupByYearMonth(
  posts.map((post) => ({ date: new Date(`${post.pubDate}T00:00:00`), data: post }))
);

const totalChars = posts.reduce((sum, post) => sum + readingTime(post.bodyMarkdown).chars, 0);
const dates = posts.map((p) => p.pubDate).sort();
const minYear = dates.length ? Number(dates[0]!.slice(0, 4)) : new Date().getFullYear();
const maxYear = dates.length ? Number(dates[dates.length - 1]!.slice(0, 4)) : minYear;

/* ---------- 标签计数 ---------- */
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN')
);

const tagChipsHtml = [
  `<button type="button" class="archive-tag-chip" data-tl-tag="all" aria-pressed="true">${esc(c('posts.allTag'))} (${total})</button>`,
  ...tags.map(
    ([tag, count]) =>
      `<button type="button" class="archive-tag-chip" data-tl-tag="${esc(tag)}" aria-pressed="false">${esc(tag)} (${count})</button>`
  ),
].join('\n              ');

/* ---------- 时间轴 ---------- */
function entryHtml(post: Post, indexInMonth: number): string {
  const no = entryNo.get(post.slug) ?? 0;
  const { chars, minutes } = readingTime(post.bodyMarkdown);
  const date = new Date(`${post.pubDate}T00:00:00`);
  const badge = post.entryBadge?.trim() || DESIGN_BADGES[post.slug] || post.tags[0] || 'ARCHIVE';
  const tagText = post.tags.length ? post.tags.join(' · ') : c('posts.uncategorized');
  const lead = leadFor(post);
  const cover = coverFor(post);
  const cardClass = cover ? 'tl-item tl-post-card' : 'tl-item tl-post-card tl-post-card--no-cover';
  const thumbHtml = cover
    ? `\n  <a class="tl-card-thumb" aria-label="阅读《${esc(post.title)}》" href="/posts/${post.slug}/">
    <img src="${esc(cover)}" alt="${esc(post.title)}" loading="lazy" />
    <span class="photo-ratio-badge">16:9</span>
  </a>`
    : '';

  return `<article class="${cardClass}" style="--i:${indexInMonth}" data-tl-entry data-article-key="${esc(
    post.slug
  )}" data-tags="${esc(post.tags.join(','))}" data-search="${esc(
    `${post.title} ${post.tags.join(' ')} ${lead}`
  )}">
  <div class="tl-item-date-col">
    <time class="tl-day-kai" datetime="${esc(post.pubDate)}">${chineseDay(date.getDate())}日</time>
    <span class="tl-day-mono">${pad2(date.getMonth() + 1)}.${pad2(date.getDate())} · #${pad2(no)}</span>
  </div>
  <div class="tl-item-content-col">
    <div class="tl-card-meta-row">
      <span class="tl-entry-badge">ENTRY #${pad2(no)} // ${esc(badge)}</span>
      <span class="tl-tag-Inline">${esc(tagText)}</span>
      <span class="tl-word-meta">约 ${chars.toLocaleString('zh-CN')} 字 · ${minutes} 分钟</span>
    </div>
    <h3 class="tl-card-title">
      <a href="/posts/${post.slug}/">${esc(cjkSpacing(post.title))}</a>
    </h3>
    <p class="tl-card-excerpt">${esc(lead)}</p>
    <div class="tl-card-foot">
      <span class="tl-slug-code">/posts/${post.slug}/</span>
      <a class="q-read-btn tl-read-btn" href="/posts/${post.slug}/">
        <span>${esc(c('posts.readLabel'))}</span>
        <span aria-hidden="true">-&gt;</span>
      </a>
    </div>
  </div>${thumbHtml}
</article>`;
}

const timelineHtml = years
  .map((year) => {
    if (year.year === null) return '';
    const yearCount = year.months.reduce((n, m) => n + m.items.length, 0);
    const monthsHtml = year.months
      .map((month, mi) => {
        if (month.month === null) return '';
        const id = `tl-month-${year.year}-${pad2(month.month)}`;
        const items = month.items
          .map((item, i) => entryHtml(item.data, i))
          .join('\n');
        return `<div class="tl-month" id="${id}" data-month-section="${year.year}-${pad2(
          month.month
        )}" style="--i:${mi}">
  <button type="button" class="tl-month-head" aria-expanded="true">
    <span class="tl-month-label">${chineseMonth(month.month)}月</span>
    <span class="tl-month-code">${year.year}.${pad2(month.month)} // ${MONTH_EN[month.month - 1]}</span>
    <span class="tl-count" data-month-count>${month.items.length} ${esc(c('posts.unit'))}</span>
    <span class="tl-chevron" aria-hidden="true">▾</span>
  </button>
  <div class="tl-panel" data-open>
    <div class="tl-items" style="--n:${month.items.length}">
${items}
    </div>
  </div>
</div>`;
      })
      .join('\n');

    return `<section class="tl-year" id="tl-year-${year.year}" data-year-section="${year.year}">
  <button type="button" class="tl-year-head" aria-expanded="true">
    <span class="tl-year-label">${chineseYear(year.year)}</span>
    <span class="tl-year-code">${year.year} CHRONICLE</span>
    <span class="tl-count" data-year-count>${yearCount} ${esc(c('posts.unit'))}</span>
    <span class="tl-chevron" aria-hidden="true">▾</span>
  </button>
  <div class="tl-panel" data-open>
    <div class="tl-body" style="--n:${year.months.length}">
${monthsHtml}
    </div>
  </div>
</section>`;
  })
  .join('\n');

const oldest = posts[posts.length - 1];
const originHtml = oldest
  ? `<div class="tl-start" aria-hidden="true">
  <span class="tl-origin-caption">${esc(c('posts.origin'))} · FIRST COMMIT ${esc(oldest.pubDate)}</span>
</div>`
  : '';

const finalTimelineHtml = total
  ? `<div class="tl-now-cap">
  <span class="tl-now-dot" aria-hidden="true"></span>
  <span class="tl-now-text">${esc(c('posts.now'))}</span>
</div>
${timelineHtml}
${originHtml}`
  : `<p class="tl-empty-state" style="display:block">${esc(c('posts.empty'))}</p>`;

/* ---------- 右栏 ---------- */
const railJumpsHtml = years
  .flatMap((year) =>
    year.year === null
      ? []
      : year.months
          .filter((m): m is typeof m & { month: number } => m.month !== null)
          .map(
            (month) => `<li>
  <button type="button" data-tl-scroll="tl-month-${year.year}-${pad2(month.month)}">
    <span class="r-idx">${year.year} // ${MONTH_EN[month.month - 1]} · ${pad2(month.month)}</span>
    <span class="r-tit">${chineseYear(year.year!)}${chineseMonth(month.month)}月（${month.items.length} ${esc(c('posts.unit'))}）</span>
  </button>
</li>`
          )
  )
  .join('\n');

const railDensityHtml = years
  .flatMap((year) =>
    year.year === null
      ? []
      : year.months
          .filter((m): m is typeof m & { month: number } => m.month !== null)
          .map((month) => {
            const pct = total ? Math.round((month.items.length / total) * 100) : 0;
            const filled = Math.max(1, Math.round((month.items.length / Math.max(1, total)) * 3));
            const bars = '█'.repeat(filled) + '░'.repeat(Math.max(0, 3 - filled));
            return `<li><span>${year.year}.${pad2(month.month)}</span><strong>${bars} ${pct}% (${month.items.length} ${esc(c('posts.unit'))})</strong></li>`;
          })
  )
  .join('\n');

const slots: Record<string, string> = {
  AXIS_YEARS: `${maxYear} — ${minYear}`,
  AXIS_COUNT: String(total),
  STAT_TOTAL: esc(c('posts.statTotal', { count: total })),
  STAT_SPAN: `${chineseYear(minYear)} — ${chineseYear(maxYear)}`,
  STAT_VISIBLE: esc(c('posts.statVisible', { count: total })),
  STAT_WORDS: esc(c('posts.statWords', { chars: totalChars.toLocaleString('zh-CN') })),
  TAG_CHIPS: tagChipsHtml,
  TIMELINE: finalTimelineHtml,
  RAIL_JUMPS: railJumpsHtml,
  RAIL_DENSITY: railDensityHtml,
};

let html = postsTpl;
for (const [key, value] of Object.entries(slots)) {
  const token = `@@${key}@@`;
  if (!html.includes(token)) console.warn('[posts] 缺占位符', token);
  html = html.split(token).join(value);
}

html = html.replace(
  /(<div class="q-topbar-cell q-topbar-cell--center">\s*)[\s\S]*?(\s*<\/div>)/,
  (_m, a: string, b: string) => `${a}${esc(c('posts.topbarNote'))}${b}`
);
html = html.replace(
  /(<div class="posts-subpage-hero-left[^>]*>\s*<span class="spot-kicker"[^>]*>)[\s\S]*?(<\/span>)/,
  (_m, a: string, b: string) => `${a}${esc(c('posts.heroKicker'))}${b}`
);
html = html.replace(
  /(<h1 class="posts-subpage-title">)[\s\S]*?(<\/h1>)/,
  (_m, a: string, b: string) => `${a}${esc(c('posts.heroTitle'))}${b}`
);
html = html.replace(
  /(<p class="posts-subpage-lead">)[\s\S]*?(<\/p>)/,
  (_m, a: string, b: string) => `${a}${esc(c('posts.heroLead'))}${b}`
);
html = html.replace(
  /(<input type="search" class="tl-search-input" id="tl-search-input" placeholder=")[^"]*(")/,
  (_m, a: string, b: string) => `${a}${esc(c('posts.searchPlaceholder'))}${b}`
);
html = html.replace(
  /(<span>RANDOM WALK \/\/ 随机漫游<\/span>\s*<span>EXPLORE<\/span>\s*<\/div>\s*<p[^>]*>)[\s\S]*?(<\/p>)/,
  (_m, a: string, b: string) => `${a}${esc(c('posts.randomWalkText'))}${b}`
);
html = html.replace(
  /(<button type="button" class="q-read-btn" id="tl-random-read-btn"[^>]*>\s*<span>)[\s\S]*?(<\/span>)/,
  (_m, a: string, b: string) => `${a}${esc(c('posts.randomWalkBtn'))}${b}`
);

html = applyArtifactSite(html, site, 'posts');
---

<ArtifactLayout
  page="posts"
  bodyClass="home"
  title={c('posts.title')}
  description={c('posts.description')}
>
  <Fragment set:html={html} />
</ArtifactLayout>

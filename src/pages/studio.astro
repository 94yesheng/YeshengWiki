---
/**
 * 后台（/studio/）—— HUD 象限蓝图画布体系重构版
 */
import '../styles/tokens.css';
import '../styles/studio.css';
import '../styles/fab.css';
import { THEME_BOOT } from '../utils/theme';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>后台工作台 · 夜笙的小世界</title>
    <meta name="theme-color" content="#faf9f5" />
    <script is:inline set:html={THEME_BOOT}></script>
  </head>
  <body class="st-body">
    <!-- 昼夜切换全屏平滑遮盖与奇点/无限流形转换层 -->
    <div class="theme-transition-stage" id="theme-transition-stage" aria-hidden="true">
      <div class="theme-transition-veil" id="theme-transition-veil"></div>
      <canvas class="theme-transition-canvas" id="theme-transition-canvas"></canvas>
      <div class="theme-transition-badge" id="theme-transition-badge">SINGULARITY TRANSITION // ∞ ↔ BLACK HOLE</div>
    </div>

    <!-- 背景平面几何水印（白天：平面双纽线无限；黑夜：卡冈图雅黑洞） -->
    <div class="st-planar-watermark" aria-hidden="true">
      <svg class="planar-wm planar-wm--infinity" viewBox="0 0 240 120">
        <circle cx="70" cy="60" r="44" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 4"/>
        <circle cx="170" cy="60" r="44" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 4"/>
        <line x1="12" y1="60" x2="228" y2="60" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 5"/>
        <line x1="120" y1="10" x2="120" y2="110" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 5"/>
        <path d="M70 16C45.7 16 26 35.7 26 60C26 84.3 45.7 104 70 104C100 104 140 16 170 16C194.3 16 214 35.7 214 60C214 84.3 194.3 104 170 104C140 104 100 16 70 16Z" fill="none" stroke="currentColor" stroke-width="1.65"/>
        <circle cx="70" cy="60" r="3" fill="currentColor"/>
        <circle cx="170" cy="60" r="3" fill="currentColor"/>
      </svg>
      <svg class="planar-wm planar-wm--blackhole" viewBox="0 0 240 120">
        <circle cx="120" cy="60" r="48" fill="none" stroke="currentColor" stroke-width="0.7" stroke-dasharray="3 5"/>
        <path d="M56 54C74 14 166 14 184 54" fill="none" stroke="currentColor" stroke-width="1.35"/>
        <path d="M68 67C86 98 154 98 172 67" fill="none" stroke="currentColor" stroke-width="1.05" stroke-opacity="0.75"/>
        <circle cx="120" cy="60" r="14" fill="currentColor"/>
        <ellipse cx="120" cy="61" rx="96" ry="18" transform="rotate(-10 120 61)" fill="none" stroke="currentColor" stroke-width="1.6"/>
      </svg>
    </div>

    <header class="st-bar site-nav-bar" id="st-bar"></header>

    <main id="st-main">
      <p class="st-boot">
        正在初始化 STUDIO 象限蓝图工作台…
        <span>如果一直停在这里，说明脚本没跑起来：按 F12 查看控制台报错，或见 <code>README.md</code> 的故障排查说明。</span>
      </p>
    </main>
    <div class="st-toast" id="st-toast" role="status" aria-live="polite"></div>

    <script>
      import '../studio/app';
    </script>
  </body>
</html>

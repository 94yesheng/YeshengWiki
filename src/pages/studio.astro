---
/**
 * 后台（/studio/）—— HUD 象限蓝图画布体系重构版
 */
import '../styles/tokens.css';
import '../styles/studio.css';
import '../styles/fab.css';
import { THEME_BOOT } from '../utils/theme';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>后台工作台 · 夜笙的小世界</title>
    <meta name="theme-color" content="#faf9f5" />
    <script is:inline set:html={THEME_BOOT}></script>
  </head>
  <body class="st-body">
    <!-- 昼夜切换全屏平滑遮盖与奇点/无限流形转换层 -->
    <div class="theme-transition-stage" id="theme-transition-stage" aria-hidden="true">
      <div class="theme-transition-veil" id="theme-transition-veil"></div>
      <canvas class="theme-transition-canvas" id="theme-transition-canvas"></canvas>
      <div class="theme-transition-badge" id="theme-transition-badge">SINGULARITY TRANSITION // ∞ ↔ BLACK HOLE</div>
    </div>

    <!-- 背景平面几何水印（白天：平面双纽线无限；黑夜：卡冈图雅黑洞） -->
    <div class="st-planar-watermark" aria-hidden="true">
      <svg class="planar-wm planar-wm--infinity" viewBox="0 0 240 120">
              <circle cx="62" cy="60" r="46" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 4"/>
              <circle cx="178" cy="60" r="46" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 4"/>
              <line x1="12" y1="60" x2="228" y2="60" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 5"/>
              <line x1="120" y1="10" x2="120" y2="110" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 5"/>
<path d="M91 31A41 41 0 1 0 91 89L149 31A41 41 0 1 1 149 89" fill="none" stroke="currentColor" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M91 31L106 46M134 74L149 89" fill="none" stroke="currentColor" stroke-width="4.2" stroke-linecap="butt"/>
              <path d="M102 52L112 42M128 78L138 68" fill="none" stroke="currentColor" stroke-width="1.8" stroke-opacity="0.55" stroke-linecap="round"/>
              <path d="M84 39A30 30 0 1 0 84 81M156 39A30 30 0 1 1 156 81" fill="none" stroke="currentColor" stroke-width="1.0" stroke-opacity="0.48" stroke-linecap="round"/>
</svg>
      <svg class="planar-wm planar-wm--blackhole" viewBox="0 0 240 120">
              <circle cx="120" cy="60" r="50" fill="none" stroke="currentColor" stroke-width="0.7" stroke-dasharray="3 5"/>
              <path d="M52 54C72 8 168 8 188 54" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
              <path d="M64 68C84 104 156 104 176 68" fill="none" stroke="currentColor" stroke-width="1.15" stroke-opacity="0.78" stroke-linecap="round"/>
              <path d="M24 60A96 26 0 0 1 216 60" transform="rotate(-10 120 60)" fill="none" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.48" stroke-dasharray="4 3"/>
              <circle cx="120" cy="60" r="23" fill="var(--paper)" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="120" cy="60" r="15.5" fill="currentColor"/>
              <path d="M24 60A96 26 0 0 0 216 60" transform="rotate(-10 120 60)" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <path d="M46 60A74 19 0 0 0 194 60" transform="rotate(-10 120 60)" fill="none" stroke="currentColor" stroke-width="0.95" stroke-dasharray="4 3"/>
            </svg>
    </div>

    <header class="st-bar site-nav-bar" id="st-bar"></header>

    <main id="st-main">
      <p class="st-boot">
        正在初始化 STUDIO 象限蓝图工作台…
        <span>如果一直停在这里，说明脚本没跑起来：按 F12 查看控制台报错，或见 <code>README.md</code> 的故障排查说明。</span>
      </p>
    </main>
    <div class="st-toast" id="st-toast" role="status" aria-live="polite"></div>

    <script>
      import '../studio/app';
    </script>
  </body>
</html>

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import { site as staticSite, type SiteConfig } from '../site.config';
import { copy, getPageValues } from '../server/pages';
import { getSetting } from '../server/repositories/settings';
import { listLinks } from '../server/repositories/links';

const site = getSetting<SiteConfig>('site', staticSite);
const links = listLinks()
  .filter((item) => item.id !== 'example' && !item.url.includes('example.com'))
  .sort((a, b) => a.name.localeCompare(b.name, 'zh-Hans-CN'));
const pages = getPageValues();
const c = (key: string, vars?: Record<string, string | number>) => copy(pages, key, vars);

interface ColophonCard {
  kicker?: string;
  title: string;
  desc: string;
}

interface AuthorDossierConfig {
  monogram?: string;
  title?: string;
  subCoord?: string;
  bio?: string;
  chips?: string[];
  colophon?: ColophonCard[];
}

const dossier = getSetting<AuthorDossierConfig>('authorDossier', {});
const colophon = (Array.isArray(dossier.colophon) ? dossier.colophon : []).filter(
  (item) => typeof item?.title === 'string' && typeof item?.desc === 'string'
);
const dossierChips = (Array.isArray(dossier.chips) ? dossier.chips : [])
  .map((s) => String(s ?? '').trim())
  .filter(Boolean);
const hasDossier = Boolean(dossier.title?.trim() || dossier.bio?.trim());

const copyDoneJson = JSON.stringify(c('links.copyDone')).replace(/</g, '\\u003c');
const siteBase = site.url.replace(/\/+$/, '');
const cardInfoJson = JSON.stringify(
  `站名：${site.title} | 网址：${siteBase} | 简介：${site.tagline} | RSS：${siteBase}/rss.xml`
).replace(/</g, '\\u003c');
---

<BaseLayout masthead={false} title={c('links.title')} description={c('links.description')}>
  <div class="wrap">
    <div class="section-head">
      <h1>
        <span class="section-planar-badge" aria-hidden="true">
          <svg class="planar-icon planar-icon--infinity" viewBox="0 0 28 14" aria-hidden="true">
<path d="M10.58 3.58A4.84 4.84 0 1 0 10.58 10.42L17.42 3.58A4.84 4.84 0 1 1 17.42 10.42" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10.58 3.58L12.2 5.2M15.8 8.8L17.42 10.42" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="butt"/>
                  <path d="M11.8 5.9L13.2 4.5M14.8 9.5L16.2 8.1" fill="none" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.58" stroke-linecap="round"/>
                </svg>
          <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 28 14" aria-hidden="true">
                  <path d="M6.0 6.2C8.5 1.2 19.5 1.2 22.0 6.2" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  <path d="M2.5 7A11.5 3.5 0 0 1 25.5 7" transform="rotate(-11 14 7)" fill="none" stroke="currentColor" stroke-width="0.95" stroke-opacity="0.42"/>
                  <circle cx="14" cy="7" r="3.5" fill="currentColor"/>
                  <path d="M2.5 7A11.5 3.5 0 0 0 25.5 7" transform="rotate(-11 14 7)" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
        </span>
        <span>{c('links.title')}</span>
      </h1>
      <p class="note">{c('links.note')}</p>
    </div>

    <!-- 第一部分：友链名录与本站名片 -->
    <section class="links-block" aria-labelledby="heading-peers">
      <div class="sub-head">
        <h2 id="heading-peers">{c('links.peersTitle')}</h2>
        <div class="sub-head-right">
          <span class="sub-note">{links.length > 0 ? c('links.peersCount', { count: links.length }) : c('links.peersEmpty')}</span>
          <button type="button" class="action-btn action-btn--compact" data-open-link-apply>＋ 申请友链</button>
        </div>
      </div>

      {
        links.length > 0 && (
          <div class="link-grid">
            {links.map((link) => (
              <LinkCard
                name={link.name}
                url={link.url}
                description={link.description}
                avatar={link.avatar ?? undefined}
                tag={link.tag ?? undefined}
                owner={link.owner ?? undefined}
              />
            ))}
          </div>
        )
      }

      {
        hasDossier && (
          <div class="site-card-box" style="margin-bottom: var(--space-4);">
            <div class="site-card-main">
              <div class="site-card-title-row">
                <h3>{dossier.title || `关于「我」 · ${site.author}`}</h3>
                <span class="site-card-badge">{dossier.subCoord || 'AUTHOR DOSSIER'}</span>
              </div>
              {dossier.bio && <p class="site-card-desc">{dossier.bio}</p>}
              {dossierChips.length > 0 && (
                <div class="dossier-chips-row">
                  {dossierChips.map((chip) => (
                    <span class="dossier-chip-pill">{chip}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        )
      }

      <div class="site-card-box">
        <div class="site-card-main">
          <div class="site-card-title-row">
            <h3>{c('links.cardTitle')}</h3>
            <span class="site-card-badge">{c('links.cardBadge')}</span>
          </div>
          <p class="site-card-desc">
            {c('links.cardIntro')}
          </p>
          <dl class="site-spec-dl">
            <div><dt>{c('links.specName')}</dt><dd>{site.title}</dd></div>
            <div><dt>{c('links.specTagline')}</dt><dd>{site.tagline}</dd></div>
            <div><dt>{c('links.specUrl')}</dt><dd>{site.url}</dd></div>
            <div><dt>{c('links.specRss')}</dt><dd><a href="/rss.xml">{site.url}/rss.xml</a></dd></div>
          </dl>
        </div>
        <div class="site-card-actions">
          <button type="button" class="action-btn" id="copy-site-card-btn">{c('links.copyBtn')}</button>
          <button type="button" class="action-btn" data-open-link-apply>＋ 申请友链</button>
          <a class="action-btn action-btn--secondary" href="/rss.xml">{c('links.rssBtn')}</a>
        </div>
      </div>
    </section>

    <!-- 第二部分：站点说明志 -->
    <section class="links-block" aria-labelledby="heading-colophon">
      <div class="sub-head">
        <h2 id="heading-colophon">{c('links.colophonTitle')}</h2>
        <span class="sub-note">{c('links.colophonNote')}</span>
      </div>

      <div class="colophon-grid">
        {
          colophon.length > 0 ? (
            colophon.map((item) => (
              <article class="colophon-card">
                {item.kicker ? <div class="colophon-kicker">{item.kicker}</div> : null}
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </article>
            ))
          ) : (
            <p class="sub-note" style="grid-column: 1 / -1;">
              {c('links.empty')}
            </p>
          )
        }
      </div>
    </section>
  </div>

  <!-- 友链互换申请悬浮窗（带流畅进出场过渡） -->
  <div class="link-apply-backdrop" id="link-apply-modal" aria-hidden="true">
    <div class="link-apply-dialog" role="dialog" aria-modal="true" aria-labelledby="link-apply-title">
      <span class="la-corner la-corner--tl"></span>
      <span class="la-corner la-corner--tr"></span>
      <span class="la-corner la-corner--bl"></span>
      <span class="la-corner la-corner--br"></span>

      <div class="link-apply-topbar">
        <div class="link-apply-topbar-left">
          <span class="site-card-badge">PEER NODE // APPLY</span>
          <span>FRIEND LINK APPLICATION · 友链互换申请表</span>
        </div>
        <button type="button" class="link-apply-close" data-close-link-apply aria-label="关闭弹窗">关闭 ×</button>
      </div>

      <form class="link-apply-form" id="link-apply-form" novalidate>
        <div class="link-apply-head">
          <h3 id="link-apply-title">申请加入独立博客友链矩阵</h3>
          <p>填写下方站点信息提交后，站长可在后台「友链」管理页查看并一键添加至友链列表。</p>
        </div>

        <div class="link-apply-grid">
          <label class="link-apply-field">
            <span class="link-apply-label"><span>01 // 站长称呼</span><em>必填</em></span>
            <input type="text" name="owner" required maxlength="48" placeholder="如：夜笙" autocomplete="nickname" />
          </label>

          <label class="link-apply-field">
            <span class="link-apply-label"><span>02 // 站点标题</span><em>必填</em></span>
            <input type="text" name="name" required maxlength="64" placeholder="如：夜笙的小世界" />
          </label>

          <label class="link-apply-field">
            <span class="link-apply-label"><span>03 // 站点链接</span><em>必填</em></span>
            <input type="url" name="url" required maxlength="256" placeholder="https://www.example.com" />
          </label>

          <label class="link-apply-field">
            <span class="link-apply-label"><span>04 // 领域标签</span><em>选填</em></span>
            <input type="text" name="tag" maxlength="32" placeholder="如：技术 · 随笔（默认：独立博客）" />
          </label>
        </div>

        <label class="link-apply-field">
          <span class="link-apply-label"><span>05 // 自我介绍 / 站点简介</span><em>必填</em></span>
          <textarea name="description" rows="3" required maxlength="320" placeholder="一句话介绍你的站点特色、记录方向或自我介绍…"></textarea>
        </label>

        <div class="link-apply-status" id="link-apply-status" role="status" aria-live="polite"></div>

        <div class="link-apply-foot">
          <button type="button" class="action-btn action-btn--secondary" data-close-link-apply>取消</button>
          <button type="submit" class="action-btn" id="link-apply-submit-btn">提交友链申请 -&gt;</button>
        </div>
      </form>
    </div>
  </div>

  <script
    is:inline
    set:html={`(() => {
  const copyBtn = document.getElementById('copy-site-card-btn');
  copyBtn?.addEventListener('click', () => {
    const info = ${cardInfoJson};
    navigator.clipboard?.writeText(info).catch(() => {});
    const orig = copyBtn.textContent;
    copyBtn.textContent = ${copyDoneJson};
    setTimeout(() => {
      copyBtn.textContent = orig;
    }, 2200);
  });

  const modal = document.getElementById('link-apply-modal');
  const form = document.getElementById('link-apply-form');
  const statusEl = document.getElementById('link-apply-status');
  const submitBtn = document.getElementById('link-apply-submit-btn');

  function setModalOpen(open) {
    if (!modal) return;
    if (open) {
      modal.dataset.open = 'true';
      modal.setAttribute('aria-hidden', 'false');
      if (statusEl) {
        statusEl.textContent = '';
        statusEl.removeAttribute('data-type');
      }
      setTimeout(() => {
        const first = form?.querySelector('input[name="owner"]');
        if (first) first.focus();
      }, 60);
    } else {
      delete modal.dataset.open;
      modal.setAttribute('aria-hidden', 'true');
    }
  }

  document.querySelectorAll('[data-open-link-apply]').forEach((btn) => {
    btn.addEventListener('click', () => setModalOpen(true));
  });

  document.querySelectorAll('[data-close-link-apply]').forEach((btn) => {
    btn.addEventListener('click', () => setModalOpen(false));
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) setModalOpen(false);
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.dataset.open === 'true') {
      setModalOpen(false);
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;
    const fd = new FormData(form);
    const payload = {
      owner: String(fd.get('owner') || '').trim(),
      name: String(fd.get('name') || '').trim(),
      url: String(fd.get('url') || '').trim(),
      tag: String(fd.get('tag') || '').trim(),
      description: String(fd.get('description') || '').trim(),
    };
    if (!payload.owner || !payload.name || !payload.url || !payload.description) {
      if (statusEl) {
        statusEl.dataset.type = 'error';
        statusEl.textContent = '请完整填写站长称呼、站点标题、站点链接与自我介绍。';
      }
      return;
    }
    if (!/^https?:\\/\\//i.test(payload.url)) {
      payload.url = 'https://' + payload.url;
    }

    submitBtn.disabled = true;
    const origText = submitBtn.textContent;
    submitBtn.textContent = '正在提交…';
    if (statusEl) {
      statusEl.dataset.type = 'info';
      statusEl.textContent = '正在向站点后台发送申请…';
    }

    try {
      const res = await fetch('/api/links/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '提交失败');
      if (statusEl) {
        statusEl.dataset.type = 'ok';
        statusEl.textContent = '✓ 友链申请已成功提交！站长审核通过后将展示在友链列表中。';
      }
      form.reset();
      setTimeout(() => setModalOpen(false), 1200);
    } catch (err) {
      if (statusEl) {
        statusEl.dataset.type = 'error';
        statusEl.textContent = (err && err.message) || '提交友链申请失败，请稍后重试。';
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = origText;
    }
  });
})();`}
  ></script>
</BaseLayout>

<style>
  .links-block + .links-block {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--rule);
  }

  .sub-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .sub-head-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .sub-head h2 {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .sub-note {
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .site-card-box {
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 94%, var(--canvas));
    border-radius: 4px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .site-card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .site-card-title-row h3 {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-md);
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .site-card-badge {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding: 0.12rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--rule));
    border-radius: 2px;
  }

  .site-card-desc {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.85;
  }

  .dossier-chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: var(--space-3);
  }

  .dossier-chip-pill {
    font-size: var(--text-xs);
    color: var(--muted);
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    border-radius: 2px;
  }

  .site-card-desc code,
  .colophon-card code {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.88em;
    background: var(--code-bg);
    padding: 0.1em 0.38em;
    border-radius: 2px;
  }

  .site-spec-dl {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--rule);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }

  .site-spec-dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.2rem 0;
  }

  .site-spec-dl dt {
    color: var(--muted);
  }

  .site-spec-dl dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
  }

  .site-spec-dl a {
    color: var(--accent);
  }

  .site-card-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .action-btn {
    padding: 0.42rem 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--rule));
    background: color-mix(in srgb, var(--accent) 10%, var(--paper));
    color: var(--accent);
    font-family: var(--sans);
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    border-radius: 3px;
    cursor: pointer;
    transition: all var(--dur-fast) ease;
  }

  .action-btn--compact {
    padding: 0.3rem 0.82rem;
    font-size: 0.82rem;
  }

  .action-btn:hover:not(:disabled) {
    background: var(--accent);
    color: #fff;
  }

  .action-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .action-btn--secondary {
    border-color: var(--rule);
    background: var(--paper);
    color: var(--ink);
  }

  .action-btn--secondary:hover:not(:disabled) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--paper));
    color: var(--accent);
  }

  .colophon-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .colophon-card {
    border: 1px solid var(--rule);
    background: var(--paper);
    border-radius: 4px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease);
  }

  .colophon-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .colophon-kicker {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .colophon-card h3 {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-md);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .colophon-card p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.85;
    color: var(--muted);
  }

  /* 友链申请弹窗样式 */
  .link-apply-backdrop {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: rgba(20, 20, 19, 0.48);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 260ms cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0s linear 260ms;
  }

  .link-apply-backdrop[data-open='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 260ms cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0s;
  }

  .link-apply-dialog {
    position: relative;
    width: min(40rem, 100%);
    background: var(--paper);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--rule));
    border-radius: 4px;
    box-shadow: 0 24px 64px -16px rgba(0, 0, 0, 0.38);
    transform: translateY(14px) scale(0.96);
    opacity: 0;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .link-apply-backdrop[data-open='true'] .link-apply-dialog {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .la-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }
  .la-corner::before,
  .la-corner::after {
    content: '';
    position: absolute;
    background: var(--accent);
  }
  .la-corner::before { width: 12px; height: 1.2px; top: 5.4px; left: 0; }
  .la-corner::after  { width: 1.2px; height: 12px; top: 0; left: 5.4px; }
  .la-corner--tl { top: -6px; left: -6px; }
  .la-corner--tr { top: -6px; right: -6px; }
  .la-corner--bl { bottom: -6px; left: -6px; }
  .la-corner--br { bottom: -6px; right: -6px; }

  .link-apply-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 90%, var(--canvas));
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .link-apply-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .link-apply-close {
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.74rem;
    padding: 0.18rem 0.6rem;

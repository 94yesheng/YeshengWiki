---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import { site as staticSite, type SiteConfig } from '../site.config';
import { getSetting } from '../server/repositories/settings';
import { listLinks } from '../server/repositories/links';

const site = getSetting<SiteConfig>('site', staticSite);
// 需求 5：过滤掉未实现的纯示例占位项（如 example.com），只展示真实友链
const links = listLinks()
  .filter((item) => item.id !== 'example' && !item.url.includes('example.com'))
  .sort((a, b) => a.name.localeCompare(b.name, 'zh-Hans-CN'));
---

<BaseLayout masthead={false} title="友链" description="常看的独立博客友链，以及关于「夜笙的小世界」的站点架构与排版说明。">
  <div class="wrap">
    <div class="section-head">
      <h1>
        <span class="section-planar-badge" aria-hidden="true">
          <svg class="planar-icon planar-icon--infinity" viewBox="0 0 28 14">
            <path d="M8.2 1.7C5.3 1.7 2.9 4.1 2.9 7C2.9 9.9 5.3 12.3 8.2 12.3C11.8 12.3 16.2 1.7 19.8 1.7C22.7 1.7 25.1 4.1 25.1 7C25.1 9.9 22.7 12.3 19.8 12.3C16.2 12.3 11.8 1.7 8.2 1.7Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="7" cy="7" r="1" fill="currentColor"/>
            <circle cx="21" cy="7" r="1" fill="currentColor"/>
          </svg>
          <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 28 14">
            <path d="M6.5 6.4C8.8 1.8 19.2 1.8 21.5 6.4" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="14" cy="7" r="3.2" fill="currentColor"/>
            <ellipse cx="14" cy="7.2" rx="11.2" ry="2.4" transform="rotate(-11 14 7.2)" fill="none" stroke="currentColor" stroke-width="1.35"/>
          </svg>
        </span>
        <span>友链</span>
      </h1>
      <p class="note">友链名录 · 本站规格 · 架构志</p>
    </div>

    <!-- 第一部分：友链名录与本站名片 -->
    <section class="links-block" aria-labelledby="heading-peers">
      <div class="sub-head">
        <h2 id="heading-peers">一、邻人友链与本站名片</h2>
        <span class="sub-note">{links.length > 0 ? `已收录 ${links.length} 个独立站点` : '虚位以待 · 欢迎互换友链'}</span>
      </div>

      {
        links.length > 0 && (
          <div class="link-grid">
            {links.map((link) => (
              <LinkCard
                name={link.name}
                url={link.url}
                description={link.description}
                avatar={link.avatar ?? undefined}
                tag={link.tag ?? undefined}
                owner={link.owner ?? undefined}
              />
            ))}
          </div>
        )
      }

      <div class="site-card-box">
        <div class="site-card-main">
          <div class="site-card-title-row">
            <h3>本站名片 · 友链互换信息</h3>
            <span class="site-card-badge">YESHENG.WIKI</span>
          </div>
          <p class="site-card-desc">
            如果你也在维护一个认真写字、记录技术笔记或生活广度的独立博客，欢迎通过下方规格互换友链。友链数据存储在服务器的 SQLite 数据库中，可通过 <code>/studio/</code> 后台即时维护。
          </p>
          <dl class="site-spec-dl">
            <div><dt>站点名称</dt><dd>{site.title}</dd></div>
            <div><dt>站点副标</dt><dd>{site.tagline}</dd></div>
            <div><dt>站点地址</dt><dd>{site.url}</dd></div>
            <div><dt>RSS 订阅</dt><dd><a href="/rss.xml">{site.url}/rss.xml</a></dd></div>
          </dl>
        </div>
        <div class="site-card-actions">
          <button type="button" class="action-btn" id="copy-site-card-btn">复制本站友链信息</button>
          <a class="action-btn action-btn--secondary" href="/rss.xml">打开 RSS 全文订阅源 →</a>
        </div>
      </div>
    </section>

    <!-- 第二部分：站点说明志 -->
    <section class="links-block" aria-labelledby="heading-colophon">
      <div class="sub-head">
        <h2 id="heading-colophon">二、站点说明（Site Colophon）</h2>
        <span class="sub-note">建站初衷 · 服务端渲染 · SQLite · 昼夜双模态</span>
      </div>

      <div class="colophon-grid">
        <article class="colophon-card">
          <div class="colophon-kicker">01 // PHILOSOPHY</div>
          <h3>关于本站 · 探索世界的广度</h3>
          <p>
            这里是夜笙的小世界。写点技术笔记（Minecraft 服务器内网穿透、Blender 三维建模入门、MapToPoster 城市经纬海报、DeepSeek 接入微信工作流），也写点日常随笔。「如果抵达不了人生的高度，那就尽可能的探索世界的广度吧。」
          </p>
        </article>

        <article class="colophon-card">
          <div class="colophon-kicker">02 // ARCHITECTURE</div>
          <h3>服务端渲染 · SQLite 数据库 · 零追踪</h3>
          <p>
            本站基于 Astro SSR 构建：文章、照片与站点设置在请求时从服务器 SQLite 读取，后台保存后即时生效，不再需要重新构建。页面仍保持纯文本传输，不挂载任何第三方统计或追踪脚本。
          </p>
        </article>

        <article class="colophon-card">
          <div class="colophon-kicker">03 // TYPOGRAPHY</div>
          <h3>纸墨排版 · 零 Webfont 隐私保护</h3>
          <p>
            全站坚持零 Webfont 下载，直接调用系统自带的楷体、宋体与黑体，不向第三方字体 CDN 暴露访客 IP。通过 <code>unicode-range</code> 复合字体（<code>KaiDigits</code> / <code>SongDigits</code>）让阿拉伯数字走黑体、中文走楷宋，并严格遵守楷体字号 ≥20px 的清晰度护栏。
          </p>
        </article>

        <article class="colophon-card">
          <div class="colophon-kicker">04 // VISUAL ENGINE</div>
          <h3>昼夜双模态 · 无限环、黑洞与三体</h3>
          <p>
            白天模式以「立体无限环（∞）」与暖奶油纸底（<code>#faf9f5</code>）呈现；夜间模式坍缩为「卡冈图雅黑洞」与深空底色（<code>#141413</code>），并在页脚点亮致敬《命运石之门》的世界线变动率辉光管；文章详细页右侧运行《三体》恒星与行星混沌引力场模型。
          </p>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-site-card-btn');
  copyBtn?.addEventListener('click', () => {
    const info = '站名：夜笙的小世界 | 网址：https://www.yesheng.wiki | 简介：一个普通人的自述 | RSS：https://www.yesheng.wiki/rss.xml';
    navigator.clipboard?.writeText(info).catch(() => {});
    const orig = copyBtn.textContent;
    copyBtn.textContent = '已复制本站名片';
    setTimeout(() => {
      copyBtn.textContent = orig;
    }, 2200);
  });
</script>

<style>
  .links-block + .links-block {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--rule);
  }

  .sub-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .sub-head h2 {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .sub-note {
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .site-card-box {
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 94%, var(--canvas));
    border-radius: 4px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .site-card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .site-card-title-row h3 {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-md);
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .site-card-badge {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding: 0.12rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--rule));
    border-radius: 2px;
  }

  .site-card-desc {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.85;
  }

  .site-card-desc code,
  .colophon-card code {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.88em;
    background: var(--code-bg);
    padding: 0.1em 0.38em;
    border-radius: 2px;
  }

  .site-spec-dl {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--rule);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }

  .site-spec-dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.2rem 0;
  }

  .site-spec-dl dt {
    color: var(--muted);
  }

  .site-spec-dl dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
  }

  .site-spec-dl a {
    color: var(--accent);
  }

  .site-card-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .action-btn {
    padding: 0.42rem 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--rule));
    background: color-mix(in srgb, var(--accent) 10%, var(--paper));
    color: var(--accent);
    font-family: var(--sans);
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    border-radius: 3px;
    cursor: pointer;
    transition: all var(--dur-fast) ease;
  }

  .action-btn:hover {
    background: var(--accent);
    color: #fff;
  }

  .action-btn--secondary {
    border-color: var(--rule);
    background: var(--paper);
    color: var(--ink);
  }

  .action-btn--secondary:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--paper));
    color: var(--accent);
  }

  .colophon-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .colophon-card {
    border: 1px solid var(--rule);
    background: var(--paper);
    border-radius: 4px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease);
  }

  .colophon-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .colophon-kicker {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .colophon-card h3 {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-md);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .colophon-card p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.85;
    color: var(--muted);
  }

  @media (max-width: 44rem) {
    .site-spec-dl,
    .colophon-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
/**
 * 主页 —— artifact 版。
 *
 * 页面结构拆在 src/artifact/home/ 下：加载层 + 页头 + 五屏 + 页脚浮层，
 * 由 HomeArtifact 按顺序拼回去；样式和行为仍在 ArtifactLayout 里内联。
 *
 * 【为什么拆】
 * 原先的 home.html 是 1.7MB 单文件（17 张 base64 图片内联），
 * 网页端 agent 读取 GitHub 仓库时会被它撑爆上下文，反复列目录。
 * 现在 HTML 每个 partial 不超过 13KB，图片单独放在 public/artifact/home/images/。
 */
export const prerender = false;

import ArtifactLayout from '../layouts/ArtifactLayout.astro';
import HomeArtifact from '../components/HomeArtifact.astro';
---

<ArtifactLayout page="home" bodyClass="home">
  <HomeArtifact />
</ArtifactLayout>

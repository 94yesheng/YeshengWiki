---
/**
 * 主页 —— 一栏一屏。
 *
 * 第一屏是站名 + 签名 + 自我介绍（hero），之后每个板块各占满一屏
 * （高度 = 100vh − 顶栏，见 base.css 的 .screen）。加一个新板块仍然只是
 * 在 site.data.json 里加一行 —— 它天然就会多出一整屏，这里不用动。
 *
 * 注意：这一页**不套 .wrap 包整页**。裹在同一个容器里就做不出满屏的色带/分隔线了
 * —— 照片页的 .gallery-page 也是同样处理（放在 .wrap 外面）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEntry from '../components/SectionEntry.astro';
import { home, site } from '../site.config';
import { getPostCover, getPostLead, getPublishedPosts } from '../utils/posts';
import { getPhotoWalls } from '../utils/photos';
import { chineseFullDate, chineseMonthDay } from '../utils/date';
import { cjkSpacing } from '../utils/typography';

const posts = await getPublishedPosts();

/* 各栏「最新的一条」：文章栏放最新那篇文章，照片栏放最新的那面墙。
   日期格式各随自己那个板块 —— 文章栏跟列表页用中文月日，照片栏跟照片页用中文全日期。 */
const newestPost = posts.length > 0 ? posts[0] : undefined;
const newestWall = (await getPhotoWalls())[0];

const postPreview = newestPost && {
  cover: getPostCover(newestPost),
  date: chineseMonthDay(newestPost.data.pubDate),
  extra: newestPost.data.tags.join(' · '),
  title: cjkSpacing(newestPost.data.title),
  /* 用正文的开头，不用 frontmatter 的 description —— 后者是搬站时硬截断的
     55 字，末句常常断在半句甚至没闭合的括号里。见 utils/posts.ts 的 getPostLead */
  text: getPostLead(newestPost),
};

const wallPreview = newestWall && {
  cover: newestWall.cover,
  date: newestWall.date ? chineseFullDate(newestWall.date) : '',
  extra: newestWall.place,
  title: cjkSpacing(newestWall.title),
  text: newestWall.note,
};

/** 只给这两栏配最新一条；程序、友链没有"条目"这个概念，保持标题 + 描述 */
const previewFor = (href: string) =>
  href === '/posts/' ? postPreview : href === '/photos/' ? wallPreview : undefined;
---

<BaseLayout bodyClass="home" masthead={false}>
  <!-- 第一屏：站名 + 签名 + 自我介绍 -->
  <section class="screen screen--hero">
    <div class="wrap">
      <h1 class="hero-title">{site.title}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-intro">
        {home.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!-- 之后每个板块各占满一屏 -->
  {home.sections.map((section) => <SectionEntry {...section} preview={previewFor(section.href)} />)}
</BaseLayout>

<style>
  /* 第一屏不画上边线 —— 它上面就是顶栏，已经有一条了 */
  .screen--hero { border-top: 0; }

  .hero-title {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-3xl);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-indent: 0.22em;   /* 抵消末字后多出的字距，视觉才真居中 */
    text-align: center;
  }

  .hero-tagline {
    margin: var(--space-4) 0 0;
    font-size: var(--text-base);
    letter-spacing: 0.16em;
    color: var(--muted);
    text-align: center;
  }

  /* 自我介绍沿用文章正文的书籍排版：首行缩进两字符。
     成段的中文卡回阅读宽 --measure（页面容器比它宽） */
  .hero-intro {
    max-width: var(--measure);
    margin: var(--space-8) auto 0;
    padding-top: var(--space-7);
    border-top: 1px solid var(--rule);
  }

  .hero-intro p {
    margin: 0 0 var(--space-4);
    font-size: var(--text-md);
    text-indent: 2em;
    line-height: 2;
  }

  .hero-intro p:last-child { margin-bottom: 0; }
</style>

<script>
  /**
   * 主页的滚动吸附 —— **自己做，不用 CSS 的 scroll-snap-type**。
   *
   * 【为什么不用 CSS】scroll-snap 的对齐动作是浏览器内部实现的，**速度和缓动
   * 没有任何属性可以调** —— 想"快一点、并且是非线性（先快后慢）"就做不到。
   * 只有自己动 scrollTo 才控制得住。所以在 base.css 里把 scroll-snap-type 撤了。
   *
   * 【手感怎么定的】
   *   · 时长 300ms —— 比浏览器默认那一下快一档，就是用户说的"稍微再快一些"
   *   · easeOutCubic（1-(1-t)³）—— 非线性：起步快、接近目标时收住，
   *     比线性自然得多，也不会有"撞上去"的顿感
   *   · 阈值 0.25 屏 —— 离某一屏不到四分之一屏才吸过去；离得远就让它自由滚，
   *     不硬拽（这是 proximity 的手感，不是 mandatory）。
   *     这个数就是"吸附距离"：调大=老远就被拽过去，调小=只有快到位了才吸
   *
   * 【两个必须注意的】
   *   · 动画里必须用 `behavior: 'instant'`。CSS 上有 `scroll-behavior: smooth`，
   *     不加这个参数的话每一帧的 scrollTo 都会各自触发一次平滑滚动，互相打架。
   *   · 用户在动画期间一动滚轮/触摸，立刻让位 —— 别和手指抢。
   */
  const screens = [...document.querySelectorAll<HTMLElement>('.screen')];

  if (screens.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const navH = document.querySelector<HTMLElement>('.site-nav-bar')?.offsetHeight ?? 0;

    const DURATION = 300;
    const THRESHOLD = 0.25;
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    let raf = 0;
    let animating = false;

    /** 某一屏对齐之后，页面应该停在的滚动位置 */
    const targetOf = (el: HTMLElement) =>
      el.getBoundingClientRect().top + window.scrollY - navH;

    const animateTo = (target: number) => {
      const start = window.scrollY;
      const delta = target - start;
      if (Math.abs(delta) < 2) return;

      cancelAnimationFrame(raf);
      animating = true;
      const t0 = performance.now();

      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / DURATION);
        window.scrollTo({ top: start + delta * easeOutCubic(p), behavior: 'instant' });
        if (p < 1) raf = requestAnimationFrame(step);
        else animating = false;
      };
      raf = requestAnimationFrame(step);
    };

    /** 滚停之后看一眼：离哪一屏最近？够近就吸过去 */
    const settle = () => {
      if (animating) return;
      const y = window.scrollY;
      const range = window.innerHeight - navH;

      let target: number | null = null;
      let dist = Infinity;
      for (const s of screens) {
        const t = targetOf(s);
        const d = Math.abs(y - t);
        if (d < dist) {
          dist = d;
          target = t;
        }
      }
      if (target !== null && dist > 2 && dist < range * THRESHOLD) animateTo(target);
    };

    // 用户一动就撒手，别和手指抢
    const abort = () => {
      cancelAnimationFrame(raf);
      animating = false;
    };
    for (const ev of ['wheel', 'touchstart', 'keydown'] as const) {
      window.addEventListener(ev, abort, { passive: true });
    }

    // 显式标成 boolean：不然 TS 会顺着这个别名把 else 分支收窄成 never
    // （它的 DOM 类型里 scrollend 恒存在，而运行时不一定）
    const hasScrollEnd: boolean = 'onscrollend' in window;
    if (hasScrollEnd) {
      window.addEventListener('scrollend', settle);
    } else {
      // 老浏览器没有 scrollend，退化成"滚停 120ms 之后再看"
      let timer = 0;
      window.addEventListener(
        'scroll',
        () => {
          clearTimeout(timer);
          timer = window.setTimeout(settle, 120);
        },
        { passive: true }
      );
    }
  }
</script>

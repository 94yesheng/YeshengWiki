---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEntry from '../components/SectionEntry.astro';
import { home } from '../site.config';
import { getPublishedPosts } from '../utils/posts';
import { chineseMonthDay, isoDate } from '../utils/date';
import { cjkSpacing } from '../utils/typography';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 4);
---

<BaseLayout>
  <div class="wrap">
    <!-- 自我介绍 -->
    <section class="intro">
      {home.intro.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <!-- 博客内容导览：加板块只需改 site.config.ts，这里不用动 -->
    <section class="sections">
      {home.sections.map((section) => <SectionEntry {...section} />)}
    </section>

    {
      latest.length > 0 && (
        <section class="latest">
          <h2 class="latest-title">最近写的</h2>
          <ol class="latest-list">
            {latest.map((post) => (
              <li>
                <time datetime={isoDate(post.data.pubDate)}>
                  {chineseMonthDay(post.data.pubDate)}
                </time>
                <a href={`/posts/${post.id}/`}>{cjkSpacing(post.data.title)}</a>
              </li>
            ))}
          </ol>
          <a class="latest-more" href="/posts/">
            全部文章 →
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* 自我介绍沿用文章正文的书籍排版：首行缩进两字符 */
  .intro {
    padding: var(--space-8) 0 var(--space-7);
  }

  .intro p {
    margin: 0 0 var(--space-3);
    text-indent: 2em;
    line-height: 2;
  }

  .intro p:last-child { margin-bottom: 0; }

  .latest { margin-top: var(--space-8); }

  .latest-title {
    margin: 0 0 var(--space-5);
    font-family: var(--kai);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--muted);
  }

  .latest-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .latest-list li {
    display: grid;
    grid-template-columns: 5.75rem 1fr;
    align-items: baseline;
    gap: 0 var(--space-4);
    padding: 0.4rem 0;
  }

  .latest-list time {
    font-family: var(--kai);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--seal);
    white-space: nowrap;
  }

  .latest-list a { transition: color var(--dur-fast) ease; }
  .latest-list a:hover { color: var(--seal); }

  .latest-more {
    display: inline-block;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    color: var(--muted);
    transition: color var(--dur-fast) ease;
  }

  .latest-more:hover { color: var(--seal); }

  @media (max-width: 34rem) {
    .intro { padding: var(--space-7) 0 var(--space-6); }

    .latest-list li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
      padding: 0.55rem 0;
    }
  }
</style>

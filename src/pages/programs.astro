---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="程序" description="做过的小工具与项目。">
  <div class="wrap">
    <div class="section-head">
      <h1>程序</h1>
      <p class="note">还在搭</p>
    </div>

    <div class="placeholder">
      <p>这一页暂时是空的。</p>
      <p>打算放自己写过的小工具和项目。等想清楚要放什么、怎么排，再往里填。</p>
    </div>
  </div>
</BaseLayout>

<style>
  .placeholder {
    /* 成段中文：卡回阅读宽（页面容器比它宽） */
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-7) 0;
    border-top: 1px solid var(--rule);
    color: var(--muted);
  }

  .placeholder p {
    margin: 0 0 var(--space-3);
    text-indent: 2em;
    line-height: 2;
  }

  .placeholder p:last-child { margin-bottom: 0; }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programsConfig } from '../site.config';

interface ProgModule {
  code?: string;
  stack?: string;
  title?: string;
  desc?: string;
  status?: string;
  progress?: number;
  metric?: string;
  href?: string;
}

interface ProgConsole {
  kicker?: string;
  title?: string;
  desc?: string;
  buildVersion?: string;
  terminalLines?: Array<{ cmd?: string; out?: string }>;
}

const prog = programsConfig as { console?: ProgConsole; modules?: ProgModule[] };
const consoleData: ProgConsole = prog.console ?? {
  kicker: 'CORE ENGINE // ACTIVE MODULE',
  title: 'Dual-Field & 3D Three-Body Engine · 昼夜流形与立体三体引力场',
  desc: '本站主页与文章页搭载的零依赖数学物理渲染器。',
  buildVersion: 'BUILD: v6.0-3D-MANIFOLD',
};
const modules = prog.modules ?? [];
const terminalLines = (consoleData.terminalLines ?? []).filter((l) => l.cmd || l.out);
---

<BaseLayout masthead={false} title="程序" description="做过的小工具与实验项目。">
  <div class="wrap">
    <div class="section-head">
      <h1>
        <span class="section-planar-badge" aria-hidden="true">
          <svg class="planar-icon planar-icon--infinity" viewBox="0 0 28 14">
            <path d="M8.2 1.7C5.3 1.7 2.9 4.1 2.9 7C2.9 9.9 5.3 12.3 8.2 12.3C11.8 12.3 16.2 1.7 19.8 1.7C22.7 1.7 25.1 4.1 25.1 7C25.1 9.9 22.7 12.3 19.8 12.3C16.2 12.3 11.8 1.7 8.2 1.7Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="7" cy="7" r="1" fill="currentColor"/>
            <circle cx="21" cy="7" r="1" fill="currentColor"/>
          </svg>
          <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 28 14">
            <path d="M6.5 6.4C8.8 1.8 19.2 1.8 21.5 6.4" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="14" cy="7" r="3.2" fill="currentColor"/>
            <ellipse cx="14" cy="7.2" rx="11.2" ry="2.4" transform="rotate(-11 14 7.2)" fill="none" stroke="currentColor" stroke-width="1.35"/>
          </svg>
        </span>
        <span>程序</span>
      </h1>
      <p class="note">小工具与物理渲染实验</p>
    </div>

    <div class="prog-grid">
      <article class="prog-card">
        <div class="prog-kicker">
          {consoleData.kicker ?? 'CORE ENGINE'}{consoleData.buildVersion ? ` · ${consoleData.buildVersion}` : ''}
        </div>
        <h2>{consoleData.title}</h2>
        <p>{consoleData.desc}</p>
        {
          terminalLines.length > 0 && (
            <div class="prog-terminal" aria-label="引擎终端遥测">
              {terminalLines.map((line) => (
                <div>
                  <span class="prog-terminal-cmd">$ {line.cmd}</span>
                  <span class="prog-terminal-out">{line.out}</span>
                </div>
              ))}
            </div>
          )
        }
        <div class="prog-foot">
          <a href="/">前往主页体验 →</a>
          <a href="/posts/mc-server/">前往文章页体验三体模型 →</a>
        </div>
      </article>

      {
        modules.map((m) => (
          <article class="prog-card">
            <div class="prog-kicker">
              {m.code ?? 'MODULE'}{m.stack ? ` · ${m.stack}` : ''}
            </div>
            <h2>{m.title ?? '未命名模块'}</h2>
            <p>{m.desc ?? ''}</p>
            <div class="prog-foot">
              {m.href && !m.href.startsWith('#') ? (
                <a href={m.href}>{m.status || '查看项目 →'}</a>
              ) : (
                <span>{(m.status || '运行中').replace(/\s*->\s*$/, '')}</span>
              )}
              {m.metric && <span class="prog-metric">{m.metric}</span>}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .prog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .prog-card {
    border: 1px solid var(--rule);
    background: var(--paper);
    border-radius: 4px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--space-3);
    transition: border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease);
  }

  .prog-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .prog-kicker {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .prog-card h2 {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-md);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .prog-card p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.85;
    color: var(--muted);
  }

  .prog-terminal {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 88%, var(--canvas));
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.68rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .prog-terminal-cmd {
    display: block;
    color: var(--accent);
  }

  .prog-terminal-out {
    display: block;
    color: var(--faint);
  }

  .prog-metric {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  .prog-foot {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--rule);
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .prog-foot a {
    color: var(--accent);
  }

  .prog-foot a:hover {
    text-decoration: underline;
  }

  @media (max-width: 44rem) {
    .prog-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { getPhotos, groupPhotosByYear } from '../utils/photos';
import { chineseYear } from '../utils/date';
import '../styles/gallery.css';

const photos = getPhotos();
const years = groupPhotosByYear(photos);
---

<BaseLayout title="照片" description="按时间排列的照片。">
  <div class="wrap wrap--wide">
    <div class="section-head">
      <h1>照片</h1>
      <p class="note">共 {photos.length} 张</p>
    </div>
  </div>

  <div class="gallery-page">
    <div class="wrap wrap--wide">
      {
        years.length === 0 && (
          <p class="gallery-empty">
            还没有照片。把图片放进 <code>src/assets/photos/</code>，
            文件名以日期开头即可 —— 例如 <code>2026-03-09-鸡煲.jpg</code>。
          </p>
        )
      }

      {
        years.map(({ year, photos: list }) => (
          <section class="gallery-year">
            <h2 class="gallery-year-mark">
              {year === null ? '未注明日期' : chineseYear(year)}
            </h2>
            <PhotoGrid photos={list} />
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

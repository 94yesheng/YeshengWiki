---
/**
 * 照片页 —— 和文章页共用同一条时间线（年 → 月 → 照片墙）。
 * 时间线在这里**只做分组**：照片照旧铺在右边，点击放大那套完全不动。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import TimelineWall from '../components/TimelineWall.astro';
import { getPhotoWalls } from '../utils/photos';
import { groupByYearMonth } from '../utils/timeline';
import '../styles/gallery.css';

const walls = await getPhotoWalls();
const photoCount = walls.reduce((sum, wall) => sum + wall.photos.length, 0);

/* 没标时间的墙 date 是 null，分组时会归到最后的"未标注时间"里 */
const years = groupByYearMonth(walls.map((wall) => ({ date: wall.date, data: wall })));
---

<BaseLayout title="照片" description="按时间排列的照片墙。">
  <div class="wrap">
    <div class="section-head">
      <h1>照片</h1>
      <p class="note">{walls.length} 面墙 · 共 {photoCount} 张</p>
    </div>
  </div>

  <div class="gallery-page">
    <div class="wrap">
      {
        walls.length === 0 ? (
          <p class="gallery-empty">
            还没有照片墙。在 <code>src/content/photos/</code> 下新增一个数据文件即可，
            格式见同目录的 README。
          </p>
        ) : (
          <Timeline years={years} Item={TimelineWall} />
        )
      }
    </div>
  </div>
</BaseLayout>

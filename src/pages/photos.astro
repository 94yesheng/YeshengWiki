---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoWall from '../components/PhotoWall.astro';
import { getPhotoWalls, groupWallsByYear } from '../utils/photos';
import { chineseYear } from '../utils/date';
import '../styles/gallery.css';

const walls = await getPhotoWalls();
const years = groupWallsByYear(walls);
const photoCount = walls.reduce((sum, wall) => sum + wall.photos.length, 0);
---

<BaseLayout title="照片" description="按时间排列的照片墙。">
  <div class="wrap">
    <div class="section-head">
      <h1>照片</h1>
      <p class="note">{walls.length} 面墙 · 共 {photoCount} 张</p>
    </div>
  </div>

  <div class="gallery-page">
    <div class="wrap">
      {
        walls.length === 0 && (
          <p class="gallery-empty">
            还没有照片墙。在 <code>src/content/photos/</code> 下新增一个数据文件即可，
            格式见同目录的 README。
          </p>
        )
      }

      {
        years.map(({ year, walls: list }) => (
          <section class="gallery-year">
            <h2 class="gallery-year-mark">{year === null ? '未标注时间' : chineseYear(year)}</h2>
            {list.map((wall) => (
              <PhotoWall wall={wall} />
            ))}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

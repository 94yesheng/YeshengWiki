---
/**
 * 照片子页 —— SSR 版。
 * 检视台、胶片条、筛选和档案网格都来自 SQLite；顶栏说明、卡片标题等全部关联后台「页面 → 相册」。
 */
export const prerender = false;

import ArtifactLayout from '../layouts/ArtifactLayout.astro';
import photosTpl from '../artifact/photos.html?raw';
import { listWalls, type Photo } from '../server/repositories/photos';
import { copy, getPageValues } from '../server/pages';
import { applyArtifactSite, getSiteConfig } from '../server/site';

const walls = listWalls();
const photos = walls.flatMap((wall) => wall.photos);
const site = getSiteConfig();
const pages = getPageValues();
const c = (key: string, vars?: Record<string, string | number>) => copy(pages, key, vars);

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const pad2 = (n: number) => String(n).padStart(2, '0');

function ratioKey(ar: number): '16:9' | '4:3' | '3:4' {
  if (ar < 0.95) return '3:4';
  if (ar > 1.6) return '16:9';
  return '4:3';
}

const DEFAULT_HIST = [20, 30, 40, 50, 60, 70, 80, 80, 70, 60, 50, 40, 30, 20, 15, 10];

function photoDb(photo: Photo, idx: number) {
  const ar = photo.ar && photo.ar > 0 ? photo.ar : 1.5;
  const ratio = ratioKey(ar);
  return {
    idx,
    ar,
    coord: photo.coord ?? `FRAME #${pad2(idx + 1)} // GROUP ${photo.group === 'earlier' ? '02 · ARCHIVE' : '01 · LATEST'}`,
    groupBadge: photo.group === 'earlier' ? 'ARCHIVE GROUP #02' : 'LATEST GROUP #01',
    title: photo.title ?? photo.caption ?? photo.file,
    story: photo.story ?? photo.caption ?? '',
    src: photo.url,
    ratioPill: photo.ratioPill ?? `${ratio} ${ar < 1 ? 'VERTICAL' : 'HORIZONTAL'}`,
    fileCode: `FILE: ${photo.file}`,
    date: photo.date ?? '',
    location: photo.location ?? '',
    aspect: photo.aspect ?? '',
    camera: photo.camera ?? '',
    lens: photo.lens ?? '',
    exposure: photo.exposure ?? '',
    color: photo.color ?? '',
    gps: photo.gps ?? '',
    ev: photo.ev ?? '',
    hist: photo.hist ?? DEFAULT_HIST,
  };
}

const db = photos.map(photoDb);

const filterChips = (() => {
  const groups = new Map<string, number>();
  const ratios = new Map<string, number>();
  for (const photo of photos) {
    const group = photo.group ?? 'latest';
    groups.set(group, (groups.get(group) ?? 0) + 1);
    const ratio = ratioKey(photo.ar && photo.ar > 0 ? photo.ar : 1.5);
    ratios.set(ratio, (ratios.get(ratio) ?? 0) + 1);
  }
  const items = [
    `<button type="button" class="archive-tag-chip" data-photo-filter="all" aria-pressed="true">${esc(c('photos.all'))} (${photos.length})</button>`,
  ];
  const groupLabels: Record<string, string> = {
    latest: c('photos.latest'),
    earlier: c('photos.earlier'),
  };
  for (const [group, count] of groups) {
    items.push(
      `<button type="button" class="archive-tag-chip" data-photo-filter="${esc(group)}" aria-pressed="false">${esc(groupLabels[group] ?? group)} (${count})</button>`
    );
  }
  for (const [ratio, count] of [...ratios].sort((a, b) => b[0].localeCompare(a[0]))) {
    const label = ratio === '3:4' ? '3:4 竖幅' : `${ratio} 横幅`;
    items.push(
      `<button type="button" class="archive-tag-chip" data-photo-filter="${esc(ratio)}" aria-pressed="false">${esc(label)} (${count})</button>`
    );
  }
  return items.join('\n              ');
})();

const filmstrip = photos
  .map((photo, i) => {
    const ar = photo.ar && photo.ar > 0 ? photo.ar : 1.5;
    const ratio = ratioKey(ar);
    const orientation = ar < 1 ? '竖' : '横';
    return `<button type="button" class="filmstrip-thumb" data-insp-select="${i}"${
      i === 0 ? ' data-active="true"' : ''
    } title="#${pad2(i + 1)} ${esc(photo.title ?? photo.caption ?? '')} (${ratio} ${orientation})">
  <span>#${pad2(i + 1)}</span><small>${ratio} ${orientation}</small>
</button>`;
  })
  .join('\n                  ');

const cards = photos
  .map((photo, i) => {
    const ar = photo.ar && photo.ar > 0 ? photo.ar : 1.5;
    const ratio = ratioKey(ar);
    const orientation = ar < 1 ? '纵向' : '横向';
    const group = photo.group ?? 'latest';
    const title = photo.title ?? photo.caption ?? photo.file;
    const date = photo.date ?? '';
    const story = photo.story ?? photo.caption ?? '';
    const exif = [photo.camera, photo.lens, photo.exposure].filter(Boolean).join(' · ') || 'EXIF PENDING';
    const caption = [date, photo.caption].filter(Boolean).join(' · ');
    return `<article class="photo-detail-card" data-photo-card="${i}" data-group="${esc(
      group
    )}" data-ratio="${ratio}"${i === 0 ? ' data-active="true"' : ''}>
  <div class="photo-detail-img-wrap" style="--ar: ${ar}">
    <img src="${esc(photo.url)}" alt="${esc(title)}" loading="lazy" />
    <span class="photo-idx-badge">#${pad2(i + 1)} · ${group === 'earlier' ? 'ARCHIVE' : 'LATEST'}</span>
    <span class="photo-ratio-badge">${ratio} · ${orientation}</span>
  </div>
  <div class="photo-detail-card-body">
    <div class="photo-detail-card-top">
      <h3>${esc(title)}</h3>
      <span class="photo-detail-date">${esc(date)}</span>
    </div>
    <p>${esc(story)}</p>
    <div class="photo-detail-exif-line">
      <span>${esc(exif)}</span>
      <a href="${esc(photo.url)}" data-lightbox data-caption="${esc(
        caption
      )}" class="peer-link-action">放大 ⤢</a>
    </div>
  </div>
</article>`;
  })
  .join('\n\n          ');

const slots: Record<string, string> = {
  PHOTO_FILTERS: filterChips,
  PHOTO_CARDS: photos.length
    ? cards
    : `<p class="tl-empty-state" style="grid-column: 1 / -1">${esc(c('photos.empty'))}</p>`,
  FILMSTRIP: filmstrip,
  PHOTO_SCROLL_LABEL: `${esc(c('photos.scrollLabel'))} (${photos.length} 张)`,
  PHOTOS_TOPBAR_TITLE: esc(c('photos.topbarTitle')),
  PHOTOS_TOPBAR_NOTE: esc(c('photos.topbarNote')),
  PHOTOS_SPEC_TITLE: esc(c('photos.specTitle')),
  PHOTOS_FILMSTRIP_TITLE: esc(c('photos.filmstripTitle')),
  PHOTOS_HIST_TITLE: esc(c('photos.histTitle')),
  PHOTOS_GRID_HINT: esc(c('photos.gridHint')),
};

let html = photosTpl;
for (const [key, value] of Object.entries(slots)) {
  const token = `@@${key}@@`;
  if (!html.includes(token)) console.warn('[photos] 缺占位符', token);
  html = html.split(token).join(value);
}

// 动态注入后台「页面 → 相册」配置的文案
html = html.replace(
  '<span>PHOTO SHOWCASE STAGE // 照片子页 · 一屏自适应光学检视台</span>',
  `<span>${esc(c('photos.topbarTitle'))}</span>`
);
html = html.replace(
  /(<div class="q-topbar-cell q-topbar-cell--center" id="photos-detail-topbar-title">\s*)[\s\S]*?(\s*<\/div>)/,
  (_m, a: string, b: string) => `${a}${esc(c('photos.topbarNote'))}${b}`
);
html = html.replace(
  '<span>PHOTO SPECIFICATION // 影像档案与拍摄信息</span>',
  `<span>${esc(c('photos.specTitle'))}</span>`
);
html = html.replace(
  '<span>QUICK FILMSTRIP // 快速切换影像（#02 为 3:4 竖向画框）</span>',
  `<span>${esc(c('photos.filmstripTitle'))}</span>`
);
html = html.replace(
  '<span>LUMINANCE &amp; SPECTRUM // 影调直方分布</span>',
  `<span>${esc(c('photos.histTitle'))}</span>`
);
html = html.replace(
  'CLICK CARD TO INSPECT ABOVE // 点击任意卡片自动滚回上方一屏画框检视',
  esc(c('photos.gridHint'))
);

html = applyArtifactSite(html, site, 'photos');

const photoJson = JSON.stringify(db).replace(/</g, '\\u003c');
---

<ArtifactLayout
  page="photos"
  bodyClass="home"
  title={c('photos.title')}
  description={c('photos.description')}
>
  <Fragment set:html={html} />
  <script is:inline set:html={`window.__PHOTO_DB = ${photoJson};`}></script>
</ArtifactLayout>

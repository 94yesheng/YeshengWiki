---
/**
 * 照片子页 —— artifact 版（一屏光学检视台 + 完整影集档案网格）。
 *
 * 模板由 scripts/import-artifact.mjs 从 demo/code_artifact (1).html 切出：
 * 原文的页内视图切换已改成真实路由，首页的「参数详情」会带 #frame-N 深链。
 */
import ArtifactLayout from '../layouts/ArtifactLayout.astro';
import photosTpl from '../artifact/photos.html?raw';
---

<ArtifactLayout
  page="photos"
  bodyClass="home"
  title="照片"
  description="保持原始比例的照片档案，可检视拍摄参数与完整影集。"
>
  <Fragment set:html={photosTpl} />
</ArtifactLayout>

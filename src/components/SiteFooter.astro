---
import { site } from '../site.config';
import { chineseYear } from '../utils/date';
import DivergenceMeter from './divergence-meter/DivergenceMeter.astro';

const year = chineseYear(new Date().getFullYear());
---

<footer class="site-foot">
  <div class="wrap">
    <div class="planar-divider-bar" aria-hidden="true">
      <span class="planar-divider-icon">
        <svg class="planar-icon planar-icon--infinity" viewBox="0 0 36 18">
          <path d="M9.5 3.5C5.2 3.5 2.5 6.1 2.5 9C2.5 11.9 5.2 14.5 9.5 14.5C14.2 14.5 21.8 3.5 26.5 3.5C30.8 3.5 33.5 6.1 33.5 9C33.5 11.9 30.8 14.5 26.5 14.5C21.8 14.5 14.2 3.5 9.5 3.5Z" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/>
          <circle cx="9.2" cy="9" r="1.2" fill="currentColor"/>
          <circle cx="26.8" cy="9" r="1.2" fill="currentColor"/>
        </svg>
        <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 36 18">
          <path d="M8.5 8.2C11.2 2.4 24.8 2.4 27.5 8.2" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
          <circle cx="18" cy="9" r="4" fill="currentColor"/>
          <ellipse cx="18" cy="9.2" rx="14.5" ry="3.1" transform="rotate(-11 18 9.2)" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
    </div>

    <div class="site-foot-inner">
      <span>
        © {year} {site.author}
        <span class="theme-foot-mark" aria-hidden="true">
          <svg class="motif-inf" viewBox="0 0 36 18" width="18" height="9">
            <path
              d="M9.5 3.5C5.2 3.5 2.5 6.1 2.5 9C2.5 11.9 5.2 14.5 9.5 14.5C14.2 14.5 21.8 3.5 26.5 3.5C30.8 3.5 33.5 6.1 33.5 9C33.5 11.9 30.8 14.5 26.5 14.5C21.8 14.5 14.2 3.5 9.5 3.5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
          <svg class="motif-hole" viewBox="0 0 24 24" width="12" height="12">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.2" />
            <circle cx="12" cy="12" r="3.4" fill="currentColor" />
            <line x1="1.5" y1="12" x2="22.5" y2="12" stroke="currentColor" stroke-width="0.8" opacity="0.55" />
          </svg>
        </span>
      </span>
      <span>
        <a href="/links/">友链与站点说明</a>
        &nbsp;·&nbsp;
        <a href="/rss.xml">RSS</a>
      </span>
    </div>

    <!-- 彩蛋：滚到页脚时数字乱跳一阵，然后定格在一个随机变动率上 -->
    <DivergenceMeter />
  </div>
</footer>

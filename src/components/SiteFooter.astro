---
import type { SiteConfig } from '../site.config';
import { chineseYear } from '../utils/date';
import DivergenceMeter from './divergence-meter/DivergenceMeter.astro';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const year = chineseYear(new Date().getFullYear());
---

<footer class="site-foot">
  <div class="wrap">
    <div class="planar-divider-bar" aria-hidden="true">
      <span class="planar-divider-icon">
        <svg class="planar-icon planar-icon--infinity" viewBox="0 0 36 18" aria-hidden="true">
<path d="M13.6 4.6A6.22 6.22 0 1 0 13.6 13.4L22.4 4.6A6.22 6.22 0 1 1 22.4 13.4" fill="none" stroke="currentColor" stroke-width="2.15" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13.6 4.6L15.7 6.7M20.3 11.3L22.4 13.4" fill="none" stroke="currentColor" stroke-width="2.15" stroke-linecap="butt"/>
              <path d="M15.1 7.6L16.9 5.8M19.1 12.2L20.9 10.4" fill="none" stroke="currentColor" stroke-width="0.95" stroke-opacity="0.58" stroke-linecap="round"/>
            </svg>
        <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 36 18" aria-hidden="true">
              <path d="M7.8 8.0C10.8 1.6 25.2 1.6 28.2 8.0" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
              <path d="M9.8 10.4C12.8 15.6 23.2 15.6 26.2 10.4" fill="none" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.78" stroke-linecap="round"/>
              <path d="M3.2 9A14.8 4.4 0 0 1 32.8 9" transform="rotate(-11 18 9)" fill="none" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.42"/>
              <circle cx="18" cy="9" r="4.5" fill="currentColor"/>
              <path d="M3.2 9A14.8 4.4 0 0 0 32.8 9" transform="rotate(-11 18 9)" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/>
            </svg>
      </span>
    </div>

    <div class="site-foot-inner">
      <span>
        © {year} {site.author}
        <span class="theme-foot-mark" aria-hidden="true">
          <svg class="motif-inf" viewBox="0 0 36 18" width="20" height="10"><path d="M13.6 4.6A6.22 6.22 0 1 0 13.6 13.4L22.4 4.6A6.22 6.22 0 1 1 22.4 13.4" fill="none" stroke="currentColor" stroke-width="2.15" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M13.6 4.6L15.7 6.7M20.3 11.3L22.4 13.4" fill="none" stroke="currentColor" stroke-width="2.15" stroke-linecap="butt"/>
<path d="M15.1 7.6L16.9 5.8M19.1 12.2L20.9 10.4" fill="none" stroke="currentColor" stroke-width="0.95" stroke-opacity="0.58" stroke-linecap="round"/></svg>
          <svg class="motif-hole" viewBox="0 0 24 24" width="12" height="12">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.2" />
            <circle cx="12" cy="12" r="3.4" fill="currentColor" />
            <line x1="1.5" y1="12" x2="22.5" y2="12" stroke="currentColor" stroke-width="0.8" opacity="0.55" />
          </svg>
        </span>
      </span>
      <span>
        <a href="/links/">友链与站点说明</a>
        &nbsp;·&nbsp;
        <a href="/rss.xml">RSS</a>
      </span>
    </div>

      <!-- 白天状态下的页脚动效展示区（纸墨律动 · 谐振波谱） -->
      <div class="foot-day-kinetic" data-foot-day-kinetic aria-hidden="true">
        <!-- 方案三 (v3)：纸墨律动 · 谐振波谱 (Warm Ink Harmonic Wave) -->
        <div class="foot-day-stage foot-day-stage--v3">
          <span class="foot-day-tag">INK HARMONIC // 432Hz</span>
          <div class="foot-v3-wave-box">
            <div class="foot-v3-bars">
              <i style="--b:0"></i><i style="--b:1"></i><i style="--b:2"></i><i style="--b:3"></i><i style="--b:4"></i>
              <i style="--b:5"></i><i style="--b:6"></i><i style="--b:7"></i><i style="--b:8"></i><i style="--b:9"></i>
              <i style="--b:10"></i><i style="--b:11"></i><i style="--b:12"></i><i style="--b:13"></i><i style="--b:14"></i>
            </div>
            <svg class="foot-v3-sine" viewBox="0 0 200 24" preserveAspectRatio="none" fill="none">
              <path class="foot-v3-path-a" d="M 0 12 Q 25 2, 50 12 T 100 12 T 150 12 T 200 12" stroke="var(--accent)" stroke-width="1.3" stroke-opacity="0.72"/>
              <path class="foot-v3-path-b" d="M 0 12 Q 25 22, 50 12 T 100 12 T 150 12 T 200 12" stroke="currentColor" stroke-width="0.95" stroke-dasharray="3 3" stroke-opacity="0.42"/>
            </svg>
          </div>
          <span class="foot-day-tag">WAVEFORM // STEADY</span>
        </div>
      </div>

    <!-- 彩蛋：滚到页脚时数字乱跳一阵，然后定格在一个随机变动率上 -->
    <DivergenceMeter />
  </div>
</footer>

---
/**
 * 时间线上的一个文章条目 —— 一行「日 + 标题」。
 *
 * 【为什么日期只写"日"】月已经在上一层的节点上了（「三月」），
 * 每条再写一遍「三月十三日」是重复。有了月这一层之后，只留日最自然。
 *
 * 带 `data-entry` 和 `data-tags`，给文章页那段标签筛选脚本用 ——
 * 属性名和以前 ChronicleList 里的保持一致，筛选脚本才不用大改。
 */
import type { Post } from '../utils/posts';
import { chineseDay, isoDate } from '../utils/date';
import { cjkSpacing } from '../utils/typography';

interface Props {
  item: Post;
}

const { item } = Astro.props;
---

<div class="tp" data-entry data-tags={item.data.tags.join(',')}>
  <time datetime={isoDate(item.data.pubDate)}>{`${chineseDay(item.data.pubDate.getDate())}日`}</time>
  <a href={`/posts/${item.id}/`}>{cjkSpacing(item.data.title)}</a>
</div>

<style>
  .tp {
    display: grid;
    /* 日期栏是给"二十四日"这四个字留的，跟着字号走 —— 改字号要回来重算 */
    grid-template-columns: 6.5rem 1fr;
    align-items: baseline;
    gap: 0 var(--space-4);
    padding: 0.35rem 0;
  }

  /* 日期用强调色（全站唯一的彩色，只给时间用）。
     字号给到 --text-md（22px）：楷体在小字号下（19px 及以下）渲染有明显像素锯齿 */
  .tp time {
    font-family: var(--kai);
    font-size: var(--text-md);
    letter-spacing: 0.08em;
    color: var(--accent);
    white-space: nowrap;
  }

  .tp a {
    font-size: var(--text-base);
    line-height: 1.6;
    /* 下划线平时是 0 宽（看不见），悬停时铺满 —— 比 text-decoration 顺手 */
    background-image: linear-gradient(var(--rule), var(--rule));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    transition: background-size var(--dur-fast) var(--ease), color var(--dur-fast) ease;
  }

  .tp a:hover {
    color: var(--accent);
    background-size: 100% 1px;
  }

  @media (max-width: 34rem) {
    .tp {
      grid-template-columns: 1fr;
      gap: 0.1rem;
      padding: 0.5rem 0;
    }
  }
</style>

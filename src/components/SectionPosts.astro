---
/**
 * 主页上的「文章」那一屏（需求 4：封面照片做好 16:9 横向图片显示的适配）。
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';

interface RecentLink {
  title: string;
  href: string;
}

interface Spot {
  title: string;
  href: string;
  cover: ImageMetadata | null;
  text?: string;
  date?: string;
  extra?: string;
}

interface Props {
  href: string;
  title: string;
  desc: string;
  recent: RecentLink[];
  spot: Spot;
}

const { href, title, desc, recent, spot } = Astro.props;
---

<section class="screen section-posts">
  <div class="wrap">
    <SectionHead href={href} title={title} desc={desc} />

    <div class="posts-split">
      <ul class="posts-recent">
        {
          recent.map((r) => (
            <li>
              <a href={r.href}><span>{r.title}</span></a>
            </li>
          ))
        }
      </ul>

      <div class="posts-spot">
        <h3 class="posts-spot-title"><a href={spot.href}>{spot.title}</a></h3>
        <p class="posts-spot-meta">
          {spot.date && <time>{spot.date}</time>}
          {spot.date && spot.extra && <span class="dot">·</span>}
          {spot.extra && <span>{spot.extra}</span>}
        </p>

        <div class:list={['posts-spot-body', !spot.cover && 'posts-spot-body--textonly']}>
          {
            spot.cover && (
              <a class="posts-spot-cover" href={spot.href} tabindex="-1" aria-hidden="true">
                <Image
                  src={spot.cover}
                  alt=""
                  widths={[320, 480, 640, 960]}
                  sizes="26rem"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )
          }
          {
            spot.text && (
              <p class="posts-spot-text">
                <a href={spot.href}>{spot.text}</a>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-posts { padding-bottom: calc(16vh + 6vh); }

  .posts-split {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  .posts-recent {
    --row-h: 5.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column-reverse;
    border-bottom: 1px solid var(--rule);
  }

  .posts-recent a {
    display: flex;
    align-items: center;
    height: var(--row-h);
    padding: 0 var(--space-2) 0 0;
    font-family: var(--kai);
    font-size: var(--text-md);
    letter-spacing: 0.06em;
    line-height: 1.45;
    color: var(--ink);
    border-top: 1px solid var(--rule);
    transition: color var(--dur-fast) ease, padding-left var(--dur-fast) var(--ease);
  }

  .posts-recent a span {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .posts-recent a:hover {
    color: var(--accent);
    padding-left: 6px;
  }

  .posts-spot {
    border-left: 1px solid color-mix(in srgb, var(--ink) 40%, transparent);
    padding-left: var(--space-7);
    min-width: 0;
  }

  .posts-spot-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4em;
    margin: 0.6rem 0 0;
    font-family: var(--kai);
    font-size: var(--text-md);
    letter-spacing: 0.1em;
  }

  .posts-spot-meta time { color: var(--accent); }
  .posts-spot-meta .dot { color: var(--faint); }
  .posts-spot-meta span { color: var(--muted); }

  .posts-spot-title {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.45;
  }

  .posts-spot-title a { color: inherit; transition: color var(--dur-fast) ease; }
  .posts-spot-title a:hover { color: var(--accent); }

  /* 需求 4：封面固定 16:9 横向比例适配 */
  .posts-spot-body {
    --lines: 7;
    --line: calc(var(--text-base) * 1.85);
    --spot-h: calc(var(--lines) * var(--line));
    display: grid;
    grid-template-columns: calc(var(--spot-h) * 16 / 9) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    margin-top: var(--space-5);
  }

  .posts-spot-body--textonly { display: block; }

  .posts-spot-cover {
    display: block;
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
  }

  .posts-spot-cover :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .posts-spot-text a {
    color: inherit;
    transition: color var(--dur-fast) ease;
  }

  .posts-spot-text a:hover { color: var(--ink); }

  .posts-spot-text {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.85;
    text-indent: 2em;
    color: var(--muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--lines);
    line-clamp: var(--lines);
    max-height: var(--spot-h);
    overflow: hidden;
  }

  @media (max-width: 56rem) {
    .posts-split { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .posts-spot { border-left: 0; padding-left: 0; border-top: 1px solid color-mix(in srgb, var(--ink) 40%, transparent); padding-top: var(--space-6); }
  }

  @media (max-width: 48rem) {
    .posts-spot-body { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .posts-spot-text { min-height: 0; }
    .posts-spot-cover { max-width: 30rem; }
  }
</style>

---
/**
 * 主页 artifact 的 HTML 组装层。
 *
 * 原先是一份 1.7MB 的 src/artifact/home.html（17 张 base64 图片内联在属性里）。
 * 现在按屏拆到 src/artifact/home/，图片放在 public/artifact/home/images/：
 *
 *   loader.html    加载层 + 昼夜过渡层
 *   header.html    粘顶导航
 *   hero.html      00 · HERO
 *   posts.html     01 · POSTS
 *   photos.html    02 · PHOTOS
 *   programs.html  03 · PROGRAMS
 *   links.html     04 · LINKS
 *   tail.html      页脚 + 悬浮球 + 实验台 + toast
 *
 * 这里只负责按原顺序拼接；样式和行为仍由 ArtifactLayout 内联的
 * artifact.css / artifact.js 提供。拆分的目的是让单文件足够小，
 * 网页端 agent 读取 GitHub 仓库时不会因为一个 1.7MB 的 HTML 撑爆上下文。
 */
import loader from '../artifact/home/loader.html?raw';
import header from '../artifact/home/header.html?raw';
import hero from '../artifact/home/hero.html?raw';
import posts from '../artifact/home/posts.html?raw';
import photos from '../artifact/home/photos.html?raw';
import programs from '../artifact/home/programs.html?raw';
import links from '../artifact/home/links.html?raw';
import tail from '../artifact/home/tail.html?raw';
---

<Fragment set:html={loader} />
<Fragment set:html={header} />
<main id="home-view">
  <Fragment set:html={hero} />
  <Fragment set:html={posts} />
  <Fragment set:html={photos} />
  <Fragment set:html={programs} />
  <Fragment set:html={links} />
</main>
<Fragment set:html={tail} />

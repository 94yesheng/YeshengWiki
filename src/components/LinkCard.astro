---
interface Props {
  name: string;
  url: string;
  description?: string;
  avatar?: string;
  tag?: string;
  owner?: string;
}

const { name, url, description, avatar, tag, owner } = Astro.props;

let host = '';
try {
  host = new URL(url).hostname.replace(/^www\./, '');
} catch {
  host = url;
}
---

<a class="link-card" href={url} target="_blank" rel="noopener noreferrer">
  <span class="link-head">
    {avatar && <span class="link-avatar" aria-hidden="true">{avatar}</span>}
    <span class="link-head-meta">
      <span class="link-name">{name}</span>
      {tag && <span class="link-tag">{tag}</span>}
    </span>
  </span>
  {description && <span class="link-desc">{description}</span>}
  <span class="link-foot">
    <span class="link-host">{host}</span>
    {owner && <span class="link-owner">{owner}</span>}
  </span>
</a>

<style>
  .link-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: 3px;
    transition: border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease);
  }

  .link-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .link-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .link-avatar {
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--rule));
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 9%, var(--paper));
    color: var(--accent);
    font-family: var(--kai);
    font-size: var(--text-base);
  }

  .link-head-meta {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .link-name {
    font-family: var(--kai);
    font-size: var(--text-md);
    letter-spacing: 0.06em;
  }

  .link-tag {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .link-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .link-owner {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .link-card:hover .link-name { color: var(--accent); }

  .link-desc {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--muted);
  }

  .link-host {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
</style>

---
import { site } from '../site.config';

interface Props {
  masthead?: boolean;
}

const { masthead = true } = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-nav-bar">
  <div class="wrap">
    <div class="site-nav-left">
      <a href="/" class="site-nav-emblem" aria-label="夜笙的小世界 主页">
        <svg class="planar-icon planar-icon--infinity" viewBox="0 0 36 18" aria-hidden="true">
          <path d="M9.5 3.5C5.2 3.5 2.5 6.1 2.5 9C2.5 11.9 5.2 14.5 9.5 14.5C14.2 14.5 21.8 3.5 26.5 3.5C30.8 3.5 33.5 6.1 33.5 9C33.5 11.9 30.8 14.5 26.5 14.5C21.8 14.5 14.2 3.5 9.5 3.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <circle cx="9.2" cy="9" r="1.3" fill="currentColor"/>
          <circle cx="26.8" cy="9" r="1.3" fill="currentColor"/>
        </svg>
        <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 36 18" aria-hidden="true">
          <path d="M8.5 8.2C11.2 2.4 24.8 2.4 27.5 8.2" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
          <circle cx="18" cy="9" r="4.2" fill="currentColor"/>
          <ellipse cx="18" cy="9.2" rx="14.5" ry="3.1" transform="rotate(-11 18 9.2)" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </a>

      <nav class="site-nav" aria-label="主导航">
        {
          site.nav.map((item, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">·</span>}
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </>
          ))
        }
      </nav>
    </div>

    <button type="button" class="nav-theme-btn" id="subpage-theme-btn" title="切换白天（无限环）/ 夜间（黑洞）模式">
      <span class="btn-planar-icon" aria-hidden="true">
        <svg class="planar-icon planar-icon--infinity" viewBox="0 0 28 14">
          <path d="M7.2 2.6C3.9 2.6 1.8 4.7 1.8 7C1.8 9.3 3.9 11.4 7.2 11.4C10.9 11.4 17.1 2.6 20.8 2.6C24.1 2.6 26.2 4.7 26.2 7C26.2 9.3 24.1 11.4 20.8 11.4C17.1 11.4 10.9 2.6 7.2 2.6Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 28 14">
          <circle cx="14" cy="7" r="3.2" fill="currentColor"/>
          <ellipse cx="14" cy="7.2" rx="11.2" ry="2.4" transform="rotate(-11 14 7.2)" fill="none" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </span>
      <span id="subpage-theme-label">白天 · 无限</span>
    </button>
  </div>
</header>

{
  masthead && (
    <div class="site-head">
      <div class="wrap">
        <div class="site-head-emblem" aria-hidden="true">
          <svg class="planar-icon planar-icon--infinity" viewBox="0 0 36 18">
            <path d="M9.5 3.5C5.2 3.5 2.5 6.1 2.5 9C2.5 11.9 5.2 14.5 9.5 14.5C14.2 14.5 21.8 3.5 26.5 3.5C30.8 3.5 33.5 6.1 33.5 9C33.5 11.9 30.8 14.5 26.5 14.5C21.8 14.5 14.2 3.5 9.5 3.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="9.2" cy="9" r="1.4" fill="currentColor"/>
            <circle cx="26.8" cy="9" r="1.4" fill="currentColor"/>
          </svg>
          <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 36 18">
            <path d="M8.5 8.2C11.2 2.4 24.8 2.4 27.5 8.2" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
            <path d="M10.5 10.2C13.2 14.8 22.8 14.8 25.5 10.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.75" stroke-linecap="round"/>
            <circle cx="18" cy="9" r="4.2" fill="currentColor"/>
            <ellipse cx="18" cy="9.2" rx="14.5" ry="3.1" transform="rotate(-11 18 9.2)" fill="none" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </div>
        <h1 class="site-title">
          <a href="/">{site.title}</a>
        </h1>
        <p class="site-tagline">{site.tagline}</p>
      </div>
    </div>
  )
}

<script>
  import { toggleTheme, isDark } from '../utils/theme';

  const btn = document.getElementById('subpage-theme-btn');
  const label = document.getElementById('subpage-theme-label');
  const syncLabel = () => {
    if (label) label.textContent = isDark() ? '夜间 · 黑洞' : '白天 · 无限';
  };
  syncLabel();
  btn?.addEventListener('click', () => {
    toggleTheme();
    syncLabel();
  });
  window.addEventListener('themechange', syncLabel);
</script>

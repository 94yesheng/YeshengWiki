---
/**
 * 纸墨页（程序 / 友链）的顶栏。
 *
 * 2026-10-18：按用户要求，顶栏结构与 HUD 页面完全统一 ——
 * 同一套 .site-nav-bar / .nav-brand / .site-nav-link 标记，
 * 样式在 base.css 里补齐；不再使用纸墨版的分隔符导航和主题按钮。
 */
import { site } from '../site.config';

interface Props {
  masthead?: boolean;
}

const { masthead = true } = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-nav-bar">
  <div class="wrap">
    <div class="nav-left-cluster">
      <a href="/" class="nav-brand" aria-label="夜笙的小世界 主页">
        <span class="nav-brand-mark" aria-hidden="true">
          <svg class="planar-icon planar-icon--infinity" viewBox="0 0 36 18" aria-hidden="true">
            <path d="M10.5 2.2C6.7 2.2 3.7 5.2 3.7 9C3.7 12.8 6.7 15.8 10.5 15.8C15.2 15.8 20.8 2.2 25.5 2.2C29.3 2.2 32.3 5.2 32.3 9C32.3 12.8 29.3 15.8 25.5 15.8C20.8 15.8 15.2 2.2 10.5 2.2Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            <circle cx="10.5" cy="9" r="1.35" fill="currentColor"/>
            <circle cx="25.5" cy="9" r="1.35" fill="currentColor"/>
          </svg>
          <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 36 18" aria-hidden="true">
            <path d="M8.5 8.2C11.2 2.4 24.8 2.4 27.5 8.2" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
            <path d="M10.5 10.2C13.2 14.8 22.8 14.8 25.5 10.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.75" stroke-linecap="round"/>
            <circle cx="18" cy="9" r="4.2" fill="currentColor"/>
            <ellipse cx="18" cy="9.2" rx="14.5" ry="3.1" transform="rotate(-11 18 9.2)" fill="none" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </span>
        <span class="nav-brand-text">{site.author}</span>
        <span class="nav-brand-coord">{site.brandCoord ?? '96REM // ULTRAWIDE'}</span>
      </a>

      <nav class="site-nav" aria-label="主导航">
        {
          site.nav.map((item, i) => (
            <a
              href={item.href}
              class="site-nav-link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              <span class="nav-idx">{String(i).padStart(2, '0')}</span>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

{
  masthead && (
    <div class="site-head">
      <div class="wrap">
        <div class="site-head-emblem" aria-hidden="true">
          <svg class="planar-icon planar-icon--infinity" viewBox="0 0 36 18">
            <path d="M10.5 2.2C6.7 2.2 3.7 5.2 3.7 9C3.7 12.8 6.7 15.8 10.5 15.8C15.2 15.8 20.8 2.2 25.5 2.2C29.3 2.2 32.3 5.2 32.3 9C32.3 12.8 29.3 15.8 25.5 15.8C20.8 15.8 15.2 2.2 10.5 2.2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="9.2" cy="9" r="1.4" fill="currentColor"/>
            <circle cx="26.8" cy="9" r="1.4" fill="currentColor"/>
          </svg>
          <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 36 18">
            <path d="M8.5 8.2C11.2 2.4 24.8 2.4 27.5 8.2" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
            <path d="M10.5 10.2C13.2 14.8 22.8 14.8 25.5 10.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.75" stroke-linecap="round"/>
            <circle cx="18" cy="9" r="4.2" fill="currentColor"/>
            <ellipse cx="18" cy="9.2" rx="14.5" ry="3.1" transform="rotate(-11 18 9.2)" fill="none" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </div>
        <h1 class="site-title">
          <a href="/">{site.title}</a>
        </h1>
        <p class="site-tagline">{site.tagline}</p>
      </div>
    </div>
  )
}

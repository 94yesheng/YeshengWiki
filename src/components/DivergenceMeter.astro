---
/**
 * 世界线变动率探测仪 —— 藏在页脚里的彩蛋（《命运石之门》里那台用辉光管做的机器）。
 *
 * 滚到页脚时数字开始乱跳，然后从左到右一位一位定下来，最后停在某个变动率上；
 * **每次刷新都是一个新的随机数**，所以没有哪一次是"对的"。
 *
 * 【为什么做成一块深色底板】
 * 辉光管的好看之处全在那圈橙色的辉光。站点是暖白纸底，橙色数字直接放上去
 * 会糊成一片、也完全没有"发光"的感觉 —— 所以这里给机器自己做了一块深色面板，
 * 它是一件**嵌在页面里的仪器**，不跟着页面的明暗主题走（夜里看也一样）。
 *
 * 【为什么 aria-hidden】
 * 它是彩蛋，不是内容。读屏软件念出一串随机的 "1 0 4 8 5 9 6" 没有任何意义。
 *
 * 【数字格式】《命运石之门》里世界线变动率基本都长成 1.xxxxxx（比如
 * Steins;Gate 线是 1.048596），所以整数位固定为 1、后面六位随机。
 */
---

<div class="dm" data-dm aria-hidden="true">
  <span class="dm-label">世界线变动率</span>
  <span class="dm-tubes">
    <span class="dm-digit" data-dm-digit>1</span>
    <span class="dm-dot">.</span>
    <span class="dm-digit" data-dm-digit>0</span>
    <span class="dm-digit" data-dm-digit>0</span>
    <span class="dm-digit" data-dm-digit>0</span>
    <span class="dm-digit" data-dm-digit>0</span>
    <span class="dm-digit" data-dm-digit>0</span>
    <span class="dm-digit" data-dm-digit>0</span>
  </span>
</div>

<style>
  .dm {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .dm-label {
    font-family: var(--kai);
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
    color: var(--faint);
  }

  /* 仪器的面板：深色、内嵌一圈极淡的边、外面一点投影，像嵌在纸里的一小块玻璃 */
  .dm-tubes {
    display: inline-flex;
    align-items: baseline;
    padding: 0.3rem 0.75rem 0.4rem;
    border-radius: 3px;
    background: #17130f;
    box-shadow:
      inset 0 0 0 1px rgba(255, 200, 160, 0.09),
      inset 0 1px 6px rgba(0, 0, 0, 0.85),
      0 2px 12px -8px rgba(0, 0, 0, 0.7);
  }

  .dm-digit,
  .dm-dot {
    font-family: ui-monospace, Consolas, "Cascadia Mono", monospace;
    font-size: var(--text-md);
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    color: #ffb072;
    /* 辉光：近处一圈实、远处一圈散，两层叠出来才像气体放电 */
    text-shadow:
      0 0 4px rgba(255, 150, 80, 0.9),
      0 0 14px rgba(255, 110, 50, 0.45);
  }

  .dm-dot { padding: 0 0.05em; }

  /* 没点亮的那几根阴极：辉光管里 0–9 的金属丝都在，只有一根通电发光，
     所以数字背后应该隐隐有个"8"。这一层就是那点残影 —— 少了它就不像辉光管 */
  .dm-digit {
    position: relative;
    display: inline-block;
  }

  .dm-digit::before {
    content: '8';
    position: absolute;
    inset: 0;
    color: #ffb072;
    opacity: 0.07;
  }

  /* 每一位定下来时轻轻跳一下 */
  .dm-digit.is-locked { animation: dm-lock 280ms var(--ease); }

  @keyframes dm-lock {
    0% { opacity: 0.45; transform: translateY(-0.14em); }
    100% { opacity: 1; transform: none; }
  }
</style>

<script>
  /**
   * 数字乱跳 → 从左到右依次定住。
   *
   * 用 IntersectionObserver 而不是"监听滚动算位置"：后者要在每次滚动里读
   * getBoundingClientRect，是典型的布局抖动来源；前者由浏览器在合成线程上判断，
   * 到点了才叫我们一次。
   *
   * 数字每次刷新都重新随机 —— 这正合它的来历（每条世界线都不一样，谁也说不准
   * 下一次读到的是哪个数）。
   */
  for (const meter of document.querySelectorAll<HTMLElement>('[data-dm]')) {
    const digits = [...meter.querySelectorAll<HTMLElement>('[data-dm-digit]')];
    if (digits.length === 0) continue;

    // 整数位固定 1（世界线变动率都是 1.xxxxxx），小数点后六位随机
    const target = digits.map((_, i) => (i === 0 ? 1 : Math.floor(Math.random() * 10)));

    const settle = () => digits.forEach((el, i) => (el.textContent = String(target[i])));

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      settle();
      continue;
    }

    const SPIN_MS = 650;   // 所有位一起乱跳多久
    const STEP_MS = 150;   // 每位之间错开多久停下来
    const TICK_MS = 45;    // 乱跳时多久换一次数字（跟屏幕刷新率走会糊成一片）

    let played = false;
    const io = new IntersectionObserver(
      (entries) => {
        if (played || !entries.some((e) => e.isIntersecting)) return;
        played = true;
        io.disconnect();

        const locked = digits.map(() => false);
        const spinner = window.setInterval(() => {
          digits.forEach((el, i) => {
            if (!locked[i]) el.textContent = String(Math.floor(Math.random() * 10));
          });
        }, TICK_MS);

        digits.forEach((el, i) => {
          window.setTimeout(() => {
            locked[i] = true;
            el.textContent = String(target[i]);
            el.classList.add('is-locked');
            if (i === digits.length - 1) window.clearInterval(spinner);
          }, SPIN_MS + i * STEP_MS);
        });
      },
      { threshold: 0.9 }
    );

    io.observe(meter);
  }
</script>

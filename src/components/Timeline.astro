---
/**
 * 时间线 —— 文章列表页和照片页共用。
 *
 * 结构是三层：**年 → 月 → 条目**。年和月都是可点的按钮，点一下折叠/展开。
 * 轴是左侧一条竖线：**最上面是「现在」，最下面（轴的另一端）是起点** ——
 * 条目从新到旧往下排，所以起点图标落在最底下，标着"时间从这里开始"。
 *
 * 【叶子为什么是"传进来的组件"】
 * 两页的条目长得完全不一样：文章页是一行「日 + 标题链接」，照片页是一整块
 * 照片墙（标题、记录、一堆照片、点击放大）。所以这里只做骨架，
 * 每条怎么渲染由调用方通过 `Item` 传进来 —— `<Item item={it.data} />`。
 * 这样分组规则、轴线、折叠逻辑只有一份，叶子各管各的。
 *
 * 【折叠怎么做动的】
 * 用 `grid-template-rows: 0fr → 1fr` —— 这是少数几个**不用知道内容高度**就能
 * 做高度动画的办法（`height: auto` 不可动画，`max-height` 那套要瞎猜一个值）。
 * 内层 `overflow: hidden` 把超出的部分裁掉，于是展开时内容从上方"长"出来、
 * 收起时从下往回收，整页看起来就是在往下伸 / 往上缩。
 * 因为动画要"看得见过程"，面板就不能再用 `hidden` 属性了（`display:none`
 * 没有过渡可言），改成 `data-open`；收起时额外用 `visibility: hidden` 把里面的
 * 按钮移出可聚焦序列 —— 光靠 `overflow: hidden` 的话 Tab 键还能跳进看不见的链接。
 *
 * ⚠️ **`overflow: hidden` 会把轴上探出去的节点一起裁掉**（踩过：月份的圆点整排消失，
 * 而年份的还在 —— 因为年份的 head 在裁剪层外面）。所以 `.tl-body`（装月份
 * 的那个盒子）往左多留了 6px 内边距、再用等量的负外边距把内容推回原位：
 * 盒子变宽了、内容没动，节点就落在安全区里了。改这里的 padding/margin 要成对改。
 *
 * 【折叠状态只存在 DOM 上】
 * `aria-expanded`（在按钮上）+ `data-open`（在面板上），不另存一份变量 ——
 * 这样标签筛选那段脚本改的是同一组属性，两边不会各记一份、互相打架。
 */
import type { TimelineYear } from '../utils/timeline';
import { chineseMonth, chineseYear } from '../utils/date';

interface Props {
  years: TimelineYear<unknown>[];
  /** 叶子组件：接收 `item`（分组前的原始数据），自己渲染一行/一块 */
  Item: any;
}

const { years, Item } = Astro.props;
---

<div class="tl" data-timeline>
  {
    years.map((y) => {
      const yearTotal = y.months.reduce((n, m) => n + m.items.length, 0);
      return (
        <section class="tl-year" data-year-section>
          <button type="button" class="tl-year-head" aria-expanded="true">
            <span class="tl-year-label">
              {y.year === null ? '未标注时间' : chineseYear(y.year)}
            </span>
            <span class="tl-count">{yearTotal}</span>
          </button>

          <div class="tl-panel" data-open>
            <div class="tl-body" style={`--n:${y.months.length}`}>
              {y.months.map((m, mi) => (
                <div class="tl-month" data-month-section style={`--i:${mi}`}>
                  {m.month !== null && (
                    <button type="button" class="tl-month-head" aria-expanded="true">
                      <span class="tl-month-label">{`${chineseMonth(m.month)}月`}</span>
                      <span class="tl-count">{m.items.length}</span>
                    </button>
                  )}
                  <div class="tl-panel" data-open>
                    <div class="tl-items" style={`--n:${m.items.length}`}>
                      {m.items.map((it, ii) => (
                        <div class="tl-item" style={`--i:${ii}`}>
                          <Item item={it.data} />
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- 轴的起点：圆环套一个实心圆。放在最底下 —— 条目是从新到旧往下排的，
       所以"时间的开头"在底部。纯装饰，不承载信息。 -->
  <div class="tl-start" aria-hidden="true"></div>
</div>

<style>
  /* --------------------------------------------------------------------------
     轴 —— 一条竖线：顶端是"现在"，底端收在起点图标上
     -------------------------------------------------------------------------- */

  .tl {
    position: relative;
    margin-left: 0.5rem;
    padding-left: var(--space-5);
  }

  /* 轴线从顶端一直延伸到起点圆环的圆心（所以 bottom 是 6px，不是 0）——
     这样线看起来是"收束在起点上"，而不是凭空垂到页面底部 */
  .tl::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 6px;
    width: 1px;
    background: var(--rule);
  }

  .tl-start {
    position: relative;
    height: 12px;
    margin-top: var(--space-6);
  }

  /* 圆环 */
  .tl-start::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(-1 * var(--space-5) - 5.5px);
    box-sizing: border-box;
    width: 12px;
    height: 12px;
    border: 2px solid var(--accent);
    border-radius: 50%;
  }

  /* 实心圆心 */
  .tl-start::after {
    content: '';
    position: absolute;
    top: 4px;
    left: calc(-1 * var(--space-5) - 1.5px);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tl-year + .tl-year { margin-top: var(--space-8); }
  .tl-month + .tl-month { margin-top: var(--space-6); }

  /* 年月都是按钮，但看上去要像标题而不是按钮 */
  .tl-year-head,
  .tl-month-head {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
    transition: color var(--dur-fast) ease;
  }

  .tl-year-head:hover,
  .tl-month-head:hover { color: var(--accent); }

  /* 节点：钉在轴线上的小圆点。
     轴线在 .tl 的 left:0、**本身还有 1px 宽**，所以它的中心落在 +0.5px 处。
     而内容被 padding-left 往右推了 --space-5，于是节点的 left 要写成
       -(半个点宽) + 0.5px        （那 0.5 就是轴线的一半，漏了它整排会偏左 1px，
                                   看起来"没对齐轴线" —— 踩过） */
  .tl-year-head::before,
  .tl-month-head::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(-1 * var(--space-5) - 2.5px);
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--rule);
    transition: background-color var(--dur-fast) ease, transform var(--dur-base) var(--ease);
  }

  /* 年的节点大一点、用强调色（年也是"时间"，配得上那唯一的彩色）；
     月的节点小一点、更淡，层级一眼分得开 */
  .tl-year-head::before {
    left: calc(-1 * var(--space-5) - 3.5px);
    width: 8px;
    height: 8px;
    margin-top: -4px;
    background: var(--accent);
  }

  .tl-year-head:hover::before,
  .tl-month-head:hover::before { background: var(--accent); transform: scale(1.2); }

  .tl-year-label {
    font-family: var(--kai);
    font-size: var(--text-lg);       /* 24px */
    letter-spacing: 0.16em;
  }

  .tl-month-label {
    font-family: var(--kai);
    /* 23px：楷体在小字号下渲染有像素锯齿，实测要 23–24px 才干净 */
    font-size: var(--text-md);
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  /* 条数：折起来之后还能看出里面有多少东西 */
  .tl-count {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  /* --------------------------------------------------------------------------
     折叠动画
     高度用 0fr → 1fr；缓动带一点点过冲（控制点 y 超过 1），所以展开到头会轻轻
     回弹一下，不像默认的 ease 那样"咔"地停住。内层再叠一个位移+淡入，
     让内容是从上方"落"下来的，而不是凭空出现。
     -------------------------------------------------------------------------- */

  .tl-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 400ms cubic-bezier(0.22, 1.12, 0.32, 1);
  }

  .tl-panel[data-open] { grid-template-rows: 1fr; }

  /* 只有 .tl-body 需要轴线安全区 —— 月份的节点在里面。.tl-items 装的是普通条目，
     不会探出轴线，所以它只要 overflow:hidden 就够了 */
  .tl-body {
    /* 往左多留 6px、再用等量负外边距推回去：盒子变宽、内容没动，
       轴上探出去的月份圆点就落在安全区里了（踩过，见组件头注释） */
    padding-left: calc(var(--space-5) + 6px);
    margin-left: calc(-1 * var(--space-5) - 6px);
  }

  .tl-body,
  .tl-items {
    overflow: hidden;   /* 0fr 时把内容裁掉，否则会溢出来 */
    visibility: hidden;
    /* 收起时等子项的错峰动画跑完再真正隐藏，不然内容会先没掉。
       480ms 是按"最多十来个兄弟"估的，条目特别多的月份可以调大 */
    transition: visibility 0s linear 480ms;
  }

  .tl-panel[data-open] > .tl-body,
  .tl-panel[data-open] > .tl-items {
    visibility: visible;
    transition: visibility 0s;
  }

  /* --------------------------------------------------------------------------
     子项依次入场 —— 不是整块淡入，而是从上往下一个一个冒出来。
     CSS 没法数兄弟的序号，所以模板里给每项写了 `--i`（第几个）和
     容器上写了 `--n`（一共几个）。
     展开：序号小的先来 → 从上往下依次展开
     收起：序号大的先走 → 从下往上依次收回（就是用户要的"反着来"）
     -------------------------------------------------------------------------- */

  .tl-body > *,
  .tl-items > * {
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 200ms ease,
      transform 300ms cubic-bezier(0.34, 1.3, 0.5, 1);
    transition-delay: calc((var(--n, 1) - 1 - var(--i, 0)) * 25ms);
  }

  .tl-panel[data-open] > .tl-body > *,
  .tl-panel[data-open] > .tl-items > * {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i, 0) * 35ms);
  }

  /* 间距要用 padding 不能用 margin：margin 会溢出到 overflow 之外，
     0fr 收起时那点空隙还在，看着像没收干净 */
  .tl-body { padding-top: var(--space-4); }
  .tl-month-head { margin-bottom: var(--space-2); }
  .tl-items { padding-left: var(--space-2); }

  @media (max-width: 34rem) {
    .tl { padding-left: var(--space-4); }
    .tl-start::before { left: calc(-1 * var(--space-4) - 5.5px); }
    .tl-start::after { left: calc(-1 * var(--space-4) - 1.5px); }
    .tl-year-head::before { left: calc(-1 * var(--space-4) - 3.5px); }
    .tl-month-head::before { left: calc(-1 * var(--space-4) - 2.5px); }
    .tl-body {
      padding-left: calc(var(--space-4) + 6px);
      margin-left: calc(-1 * var(--space-4) - 6px);
    }
  }
</style>

<script>
  /**
   * 折叠：点年折整年，点月折那个月。
   *
   * 状态只放在 DOM 上（按钮的 `aria-expanded` + 面板的 `data-open`），不另存一份 ——
   * 这样标签筛选那段脚本可以直接改同一组属性，两边不会各记一份、互相打架。
   * （面板不用 `hidden` 是因为那样就没有高度动画了，见组件头的说明。）
   */
  for (const root of document.querySelectorAll<HTMLElement>('[data-timeline]')) {
    root.addEventListener('click', (event) => {
      const head = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '.tl-year-head, .tl-month-head'
      );
      if (!head) return;

      const panel = head.nextElementSibling as HTMLElement | null;
      if (!panel) return;

      const open = head.getAttribute('aria-expanded') !== 'false';
      head.setAttribute('aria-expanded', String(!open));
      if (open) delete panel.dataset.open;
      else panel.dataset.open = '';
    });
  }
</script>

---
/**
 * 时间线 —— 文章列表页和照片页共用。
 *
 * 结构是三层：**年 → 月 → 条目**。年和月都是可点的按钮，点一下折叠/展开。
 * 轴是左侧一条竖线，最上面一个「起点」图标（圆环套实心圆），下面串着年月的节点。
 *
 * 【叶子为什么是"传进来的组件"】
 * 两页的条目长得完全不一样：文章页是一行「日 + 标题链接」，照片页是一整块
 * 照片墙（标题、记录、一堆照片、点击放大）。所以这里只做骨架，
 * 每条怎么渲染由调用方通过 `Item` 传进来 —— `<Item item={it.data} />`。
 * 这样分组规则、轴线、折叠逻辑只有一份，叶子各管各的。
 *
 * 【折叠怎么做动的】
 * 用 `grid-template-rows: 0fr → 1fr` —— 这是少数几个**不用知道内容高度**就能
 * 做高度动画的办法（`height: auto` 是不可动画的，`max-height` 那套要瞎猜一个值）。
 * 内层必须 `overflow: hidden` 让超出的部分被裁掉。
 * 因为动画要"看得见过程"，面板就不能再用 `hidden` 属性了（`display:none`
 * 没有过渡可言），改成 `data-open`；收起时额外用 `visibility: hidden` 把里面的
 * 按钮移出可聚焦序列 —— 光靠 `overflow: hidden` 的话 Tab 键还能跳进看不见的链接。
 *
 * 【折叠状态只存在 DOM 上】
 * `aria-expanded`（在按钮上）+ `data-open`（在面板上），不另存一份变量 ——
 * 这样标签筛选那段脚本改的是同一组属性，两边不会各记一份、互相打架。
 */
import type { TimelineYear } from '../utils/timeline';
import { chineseMonth, chineseYear } from '../utils/date';

interface Props {
  years: TimelineYear<unknown>[];
  /** 叶子组件：接收 `item`（分组前的原始数据），自己渲染一行/一块 */
  Item: any;
}

const { years, Item } = Astro.props;
---

<div class="tl" data-timeline>
  <!-- 轴的起点：圆环套一个实心圆。纯装饰，不承载信息 -->
  <div class="tl-start" aria-hidden="true"></div>

  {
    years.map((y) => {
      const yearTotal = y.months.reduce((n, m) => n + m.items.length, 0);
      return (
        <section class="tl-year" data-year-section>
          <button type="button" class="tl-year-head" aria-expanded="true">
            <span class="tl-year-label">
              {y.year === null ? '未标注时间' : chineseYear(y.year)}
            </span>
            <span class="tl-count">{yearTotal}</span>
          </button>

          <div class="tl-panel" data-open>
            <div class="tl-body">
              {y.months.map((m) => (
                <div class="tl-month" data-month-section>
                  {m.month !== null && (
                    <button type="button" class="tl-month-head" aria-expanded="true">
                      <span class="tl-month-label">{`${chineseMonth(m.month)}月`}</span>
                      <span class="tl-count">{m.items.length}</span>
                    </button>
                  )}
                  <div class="tl-panel" data-open>
                    <div class="tl-items">
                      {m.items.map((it) => (
                        <Item item={it.data} />
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<style>
  /* --------------------------------------------------------------------------
     轴 —— 一条竖线 + 顶端的起点图标
     -------------------------------------------------------------------------- */

  .tl {
    position: relative;
    margin-left: 0.5rem;
    padding-left: var(--space-5);
  }

  /* 轴线从起点圆环的圆心开始往下 —— 所以是 top: 6px 而不是 0，
     这样线看起来是"从起点出发"，而不是从页面顶端垂下来 */
  .tl::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }

  .tl-start {
    position: relative;
    height: 12px;
    margin-bottom: var(--space-6);
  }

  /* 圆环 */
  .tl-start::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(-1 * var(--space-5) - 6px);
    box-sizing: border-box;
    width: 12px;
    height: 12px;
    border: 2px solid var(--accent);
    border-radius: 50%;
  }

  /* 实心圆心：半个环的内径，正好落在圆心 */
  .tl-start::after {
    content: '';
    position: absolute;
    top: 4px;
    left: calc(-1 * var(--space-5) - 2px);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tl-year + .tl-year { margin-top: var(--space-8); }
  .tl-month + .tl-month { margin-top: var(--space-6); }

  /* 年月都是按钮，但看上去要像标题而不是按钮 */
  .tl-year-head,
  .tl-month-head {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
    transition: color var(--dur-fast) ease;
  }

  .tl-year-head:hover,
  .tl-month-head:hover { color: var(--accent); }

  /* 节点：钉在轴线上的小圆点。
     轴线在 .tl 的 left:0，而内容被 padding-left 往右推了 --space-5 ——
     所以"从内容左边缘往左退 --space-5"就落在线上了，再退半个点宽让圆点居中。 */
  .tl-year-head::before,
  .tl-month-head::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(-1 * var(--space-5) - 3.5px);
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--rule);
    transition: background-color var(--dur-fast) ease;
  }

  /* 年的节点大一点、用强调色（年也是"时间"，配得上那唯一的彩色）；
     月的节点小一点、更淡，层级一眼分得开 */
  .tl-year-head::before {
    left: calc(-1 * var(--space-5) - 4.5px);
    width: 8px;
    height: 8px;
    margin-top: -4px;
    background: var(--accent);
  }

  .tl-year-head:hover::before,
  .tl-month-head:hover::before { background: var(--accent); }

  .tl-year-label {
    font-family: var(--kai);
    font-size: var(--text-lg);       /* 24px */
    letter-spacing: 0.16em;
  }

  .tl-month-label {
    font-family: var(--kai);
    /* 23px：楷体在小字号下渲染有像素锯齿，实测要 23–24px 才干净 */
    font-size: var(--text-md);
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  /* 条数：折起来之后还能看出里面有多少东西 */
  .tl-count {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  /* --------------------------------------------------------------------------
     折叠动画：0fr → 1fr
     -------------------------------------------------------------------------- */

  .tl-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-base) var(--ease);
  }

  .tl-panel[data-open] { grid-template-rows: 1fr; }

  .tl-body,
  .tl-items {
    overflow: hidden;   /* 0fr 时把内容裁掉，否则会溢出来 */
    visibility: hidden;
    /* 收起时等高度动画跑完再真正隐藏（不然动画还没播内容就没了） */
    transition: visibility 0s linear var(--dur-base);
  }

  .tl-panel[data-open] > .tl-body,
  .tl-panel[data-open] > .tl-items {
    visibility: visible;
    transition: visibility 0s;
  }

  /* 间距要用 padding 不能用 margin：margin 会溢出到 overflow 之外，
     0fr 收起时那点空隙还在，看着像没收干净 */
  .tl-body { padding-top: var(--space-4); }
  .tl-month-head { margin-bottom: var(--space-2); }
  .tl-items { padding-left: var(--space-2); }

  @media (max-width: 34rem) {
    .tl { padding-left: var(--space-4); }
    .tl-start::before { left: calc(-1 * var(--space-4) - 6px); }
    .tl-start::after { left: calc(-1 * var(--space-4) - 2px); }
    .tl-year-head::before { left: calc(-1 * var(--space-4) - 4.5px); }
    .tl-month-head::before { left: calc(-1 * var(--space-4) - 3.5px); }
  }
</style>

<script>
  /**
   * 折叠：点年折整年，点月折那个月。
   *
   * 状态只放在 DOM 上（按钮的 `aria-expanded` + 面板的 `data-open`），不另存一份 ——
   * 这样标签筛选那段脚本可以直接改同一组属性，两边不会各记一份、互相打架。
   * （面板不用 `hidden` 是因为那样就没有高度动画了，见组件头的说明。）
   */
  for (const root of document.querySelectorAll<HTMLElement>('[data-timeline]')) {
    root.addEventListener('click', (event) => {
      const head = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '.tl-year-head, .tl-month-head'
      );
      if (!head) return;

      const panel = head.nextElementSibling as HTMLElement | null;
      if (!panel) return;

      const open = head.getAttribute('aria-expanded') !== 'false';
      head.setAttribute('aria-expanded', String(!open));
      if (open) delete panel.dataset.open;
      else panel.dataset.open = '';
    });
  }
</script>

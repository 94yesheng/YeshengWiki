---
import { groupByYear, type Post } from '../utils/posts';
import { chineseYear, chineseMonthDay, isoDate } from '../utils/date';
import { cjkSpacing } from '../utils/typography';

interface Props {
  posts: Post[];
  /** 开启后每条会带上 data-tags，供文章页的标签筛选使用 */
  filterable?: boolean;
}

const { posts, filterable = false } = Astro.props;
const years = groupByYear(posts);
---

<div class="chronicle">
  {
    years.map(({ year, posts: list }) => (
      <section class="year" data-year-section>
        <h2 class="year-mark">{chineseYear(year)}</h2>
        <ol class="entries">
          {list.map((post) => (
            <li
              class="entry"
              data-entry={filterable ? '' : undefined}
              data-tags={filterable ? post.data.tags.join(',') : undefined}
            >
              <time datetime={isoDate(post.data.pubDate)}>
                {chineseMonthDay(post.data.pubDate)}
              </time>
              <a href={`/posts/${post.id}/`}>{cjkSpacing(post.data.title)}</a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .year + .year { margin-top: var(--space-7); }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 5.75rem 1fr;
    align-items: baseline;
    gap: 0 var(--space-4);
    padding: 0.45rem 0;
  }

  /* 日期栏用朱红 —— 全站唯一的彩色，只给时间用 */
  .entry time {
    font-family: var(--kai);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--seal);
    white-space: nowrap;
  }

  .entry a {
    font-size: var(--text-base);
    line-height: 1.6;
    background-image: linear-gradient(var(--rule), var(--rule));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    transition: background-size var(--dur-fast) var(--ease), color var(--dur-fast) ease;
  }

  .entry a:hover {
    color: var(--seal);
    background-size: 100% 1px;
  }

  @media (max-width: 34rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.1rem;
      padding: 0.6rem 0;
    }
  }
</style>

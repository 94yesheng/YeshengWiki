---
/**
 * 右下角的圆形悬浮窗 —— 点一下展开，里面是「夜间模式」和「回到顶部」。
 * 以后要加功能，就往 .fab-actions 里再塞一个 <button>，并在脚本里接上 data-action。
 *
 * 【挂在哪】BaseLayout 的 SiteFooter 之后，所以**所有访客页面**都有。
 * 后台 /studio/ 是独立页面、不用 BaseLayout，所以不会有它 —— 那是另一个应用。
 *
 * 【脚本怎么写】跟 PhotoWall.astro 的灯箱同一套路：裸 <script>、没有 import、
 * 不依赖 DOM 就绪（组件可能在页面里出现多次，但 Astro 打包后只执行一次）。
 *
 * 【z-index 必须低于灯箱】照片页的灯箱是 60（gallery.css），这里用 50 ——
 * 否则看大图时右下角会压着一个圆按钮。
 *
 * 【图标】用 Unicode 字形 + aria-label，跟站里现有做法一致（灯箱的 × ‹ ›、
 * 子页入口的 → 都是这么写的），不引入图标库。
 */
---

<div class="fab" id="fab">
  <div class="fab-actions" id="fab-actions">
    <button type="button" class="fab-btn" data-action="theme" aria-label="切换到夜间模式">
      <span data-theme-icon aria-hidden="true">☾</span>
    </button>
    <button type="button" class="fab-btn" data-action="top" aria-label="回到顶部">
      <span aria-hidden="true">↑</span>
    </button>
  </div>

  <button
    type="button"
    class="fab-btn fab-btn--main"
    id="fab-main"
    aria-expanded="false"
    aria-controls="fab-actions"
    aria-label="更多操作"
  >
    <span data-main-icon aria-hidden="true">+</span>
  </button>
</div>

<style>
  .fab {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    /* 低于照片灯箱的 60 —— 看大图时它必须在下面 */
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  /* 收起时不是 display:none 而是 visibility:hidden ——
     用 display 的话没有过渡可言，弹出动效就做不出来；
     visibility 同样会把里面的按钮移出可聚焦序列和无障碍树，不影响键盘。 */
  .fab-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.6rem) scale(0.9);
    transform-origin: bottom center;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      visibility 0s linear var(--dur-fast); /* 收起时等淡出跑完再真正隐藏 */
  }

  .fab[data-open] .fab-actions {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      visibility 0s;
  }

  /* 减少动效时不做弹出动画（base.css 那段会把时长压到 0，够用了） */

  .fab-btn {
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper);
    color: var(--muted);
    font-family: var(--kai);
    font-size: var(--text-md);
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 18px -10px rgba(0, 0, 0, 0.45);
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      transform var(--dur-fast) var(--ease);
  }

  /* 不要写 outline: none —— 全站唯一的 focus 样式是 base.css 里的 :focus-visible，
     清掉它键盘用户就找不到焦点了 */
  .fab-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .fab-btn:active { transform: scale(0.94); }

  /* 主按钮：白天用强调色（Claude 橙）、图标白。
     选中/悬停时用**偏浅的强调色** —— 跟纯色比一眼能看出按下了 */
  .fab-btn--main {
    width: 3.75rem;
    height: 3.75rem;
    font-size: var(--text-xl);   /* 图标比原来大一号 */
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }

  .fab-btn--main:hover {
    color: #fff;
    border-color: color-mix(in srgb, var(--accent) 74%, #fff);
    background: color-mix(in srgb, var(--accent) 74%, #fff);
  }

  /* 夜间换成浅灰（深底上再用橙会太跳），图标仍是白的；
     悬停时再浅一档 */
  :root[data-theme='dark'] .fab-btn--main {
    background: var(--faint);
    border-color: var(--faint);
  }

  :root[data-theme='dark'] .fab-btn--main:hover {
    background: color-mix(in srgb, var(--faint) 78%, #fff);
    border-color: color-mix(in srgb, var(--faint) 78%, #fff);
  }

  /* 键盘焦点落在主按钮上时也亮一下，和悬停同一套 */
  .fab-btn--main:focus-visible {
    background: color-mix(in srgb, var(--accent) 74%, #fff);
    border-color: color-mix(in srgb, var(--accent) 74%, #fff);
  }

  @media (prefers-reduced-motion: reduce) {
    .fab-btn:active { transform: none; }
    .fab-actions { transition: none; }
  }
</style>

<script>
  const fab = document.getElementById('fab');
  if (fab) {
    const main = fab.querySelector<HTMLButtonElement>('#fab-main');
    const themeBtn = fab.querySelector<HTMLButtonElement>('[data-action="theme"]');
    const icon = fab.querySelector<HTMLElement>('[data-theme-icon]');
    const mainIcon = fab.querySelector<HTMLElement>('[data-main-icon]');

    const isOpen = () => fab.dataset.open === 'true';

    /** 深浅切换按钮的图标/文案要跟着当前主题走 */
    const syncThemeBtn = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      if (icon) icon.textContent = dark ? '☀' : '☾';
      themeBtn?.setAttribute('aria-label', dark ? '切换到白天模式' : '切换到夜间模式');
    };

    /** 手机浏览器地址栏的颜色跟着主题变 */
    const syncThemeColor = () => {
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) {
        meta.setAttribute(
          'content',
          document.documentElement.dataset.theme === 'dark' ? '#141413' : '#faf9f5'
        );
      }
    };

    syncThemeBtn();

    const setOpen = (open: boolean, focusPanel = true) => {
      // 用 data-open 而不是 hidden：隐藏靠 CSS 的 visibility，
      // 这样才有过渡可做（见上面 .fab-actions 的注释）
      if (open) fab.dataset.open = 'true';
      else delete fab.dataset.open;
      main?.setAttribute('aria-expanded', String(open));
      if (mainIcon) mainIcon.textContent = open ? '×' : '+';
      // 只在用户主动操作时搬焦点；首屏初始化时别去抢
      if (focusPanel) {
        const target = open
          ? fab.querySelector<HTMLButtonElement>('.fab-actions button')
          : main;
        target?.focus();
      }
    };

    main?.addEventListener('click', () => setOpen(!isOpen()));

    // Esc 收起并把焦点还回主按钮 —— 项目里灯箱有这个缺口的先例，这里补上
    fab.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && isOpen()) setOpen(false);
    });

    themeBtn?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* 隐私模式下 localStorage 会抛异常 —— 那样就只是记不住，功能不受影响 */
      }
      syncThemeBtn();
      syncThemeColor();
    });

    fab.querySelector('[data-action="top"]')?.addEventListener('click', () => {
      // 平滑与否交给 CSS 的 scroll-behavior（prefers-reduced-motion 时它自己会关掉）
      window.scrollTo({ top: 0 });
      setOpen(false, false);
    });
  }
</script>

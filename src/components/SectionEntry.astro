---
/**
 * 主页上的子页入口 —— 现在**一整屏一块**（.screen 见 base.css）。
 * 加一个新板块 = 在 site.config.ts 的 home.sections 里加一行 + 建对应页面，
 * 不需要动这个组件，也不需要动主页；新板块天然也是满屏的一屏。
 *
 * 【可选的最新一条】传 preview 就会在描述下面多出一块：左边封面、右边
 * 「时间 · 标签 / 标题 / 一句话」。文章栏和照片栏用它把各自最新的一条亮出来；
 * 没传（程序、友链）就只是标题 + 描述。
 *
 * preview 是**整块链接的一部分**，里面不再套 <a>（a 里嵌 a 是非法的），
 * 点哪儿都进这个板块的主页 —— 最新那条就在那个列表的最上面。
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Preview {
  /** 封面；没有就整块变单栏 */
  cover: ImageMetadata | null;
  /** 时间 —— 全站唯一的彩色（强调色）只留给时间用 */
  date?: string;
  /** 灰字的补充：标签 / 地点 */
  extra?: string;
  /** 最新那条的标题 */
  title: string;
  /** 一句话：梗概 / 记录文字 */
  text?: string;
}

interface Props {
  href: string;
  title: string;
  desc: string;
  preview?: Preview;
}

const { href, title, desc, preview } = Astro.props;
---

<a class="screen section-entry" href={href}>
  <div class="wrap">
    <div class="section-entry-head">
      <h2 class="section-entry-title">{title}</h2>
      <span class="section-entry-arrow" aria-hidden="true">→</span>
    </div>

    <p class="section-entry-desc">{desc}</p>

    {
      preview && (
        <div class:list={['section-entry-preview', !preview.cover && 'section-entry-preview--textonly']}>
          {preview.cover && (
            <div class="section-entry-cover">
              <Image
                src={preview.cover}
                alt=""
                widths={[240, 400, 640, 900]}
                sizes="22rem"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="section-entry-info">
            {(preview.date || preview.extra) && (
              <p class="section-entry-meta">
                {preview.date && <time>{preview.date}</time>}
                {preview.date && preview.extra && <span class="dot">·</span>}
                {preview.extra && <span>{preview.extra}</span>}
              </p>
            )}
            <h3 class="section-entry-latest">{preview.title}</h3>
            {preview.text && <p class="section-entry-text">{preview.text}</p>}
          </div>
        </div>
      )
    }
  </div>
</a>

<style>
  /* 整块可点，但不再像原来那样 hover 时整行右移 ——
     一整屏的区块位移会晃得很怪，改成标题变色 + 箭头轻推 */
  .section-entry-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  /* 每一屏相当于一章的标题页，所以标题比列表页的版块名还大一号 */
  .section-entry-title {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: 0.12em;
    transition: color var(--dur-fast) ease;
  }

  .section-entry:hover .section-entry-title { color: var(--accent); }

  .section-entry-arrow {
    font-size: var(--text-md);
    color: var(--faint);
    transition: color var(--dur-fast) ease, transform var(--dur-fast) var(--ease);
  }

  .section-entry:hover .section-entry-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* 子内容往右缩两格 —— 像中文段首空两格那样，
     标题留在左边、下面这块退进去，一眼能看出是从属关系 */
  .section-entry-desc {
    margin: var(--space-4) 0 0 2em;
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--muted);
  }

  /* ---------- 最新一条 ---------- */

  .section-entry-preview {
    display: grid;
    grid-template-columns: 22rem 1fr;
    gap: var(--space-6);
    align-items: center;
    margin: var(--space-7) 0 0 2em;
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  /* 没有封面就整块变单栏，不留一个空位 */
  .section-entry-preview--textonly { grid-template-columns: 1fr; }

  .section-entry-cover {
    overflow: hidden;
    border-radius: 2px;
    /* 配图基本都是 16:9 的截图，用同一个比例就几乎不裁切 */
    aspect-ratio: 16 / 9;
  }

  .section-entry-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease);
  }

  .section-entry:hover .section-entry-cover :global(img) { transform: scale(1.04); }

  /* min-width:0 让它能在网格里正常收缩；右侧留白是用户要的
     "省略号后的文段不要完全和右侧重叠" —— 文字别顶到块的右边界上 */
  .section-entry-info {
    min-width: 0;
    padding-right: var(--space-8);
  }

  .section-entry-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4em;
    margin: 0 0 0.4rem;
    font-family: var(--kai);
    /* 楷体要 23–24px 才干净（见 tokens.css 的「楷体的下限」），别再往下调 */
    font-size: var(--text-md);
    letter-spacing: 0.1em;
  }

  .section-entry-meta time { color: var(--accent); }
  .section-entry-meta .dot { color: var(--faint); }
  .section-entry-meta span { color: var(--muted); }

  .section-entry-latest {
    margin: 0;
    font-family: var(--kai);
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.5;
    transition: color var(--dur-fast) var(--ease);
  }

  .section-entry:hover .section-entry-latest { color: var(--accent); }

  /* 梗概是正文开头那一段，可能偏长 —— 三行之后由浏览器补省略号。
     **不要自己拼 "…"**：换行位置是浏览器算的，手拼的省略号会对不上位置、
     要么提前冒出来要么被裁掉。line-clamp 的省略号才是准的。 */
  .section-entry-text {
    margin: 0.4rem 0 0;
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  /* 窄屏叠成上下（不专门做手机端适配，只是别挤爆） */
  @media (max-width: 34rem) {
    .section-entry-preview { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>

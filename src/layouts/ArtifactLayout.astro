---
/**
 * artifact 主页 / 文章页的独立 shell。
 */

import homeSnap from '../artifact/home-snap.js?raw';
import {
  ARTIFACT_CSS_HASH as cssHash,
  ARTIFACT_JS_HASH as jsHash,
  faviconInfo,
  getSiteConfig,
} from '../server/site';
import { cjkSpacing } from '../utils/typography';
import { TELEMETRY_BEACON, THEME_BOOT } from '../utils/theme';

interface Props {
  title?: string;
  description?: string;
  /** body 上的 class（artifact 原文件是 home；文章页用 article） */
  bodyClass?: string;
  /** 交给脚本读：决定初始 state.view */
  page?: 'home' | 'posts' | 'article' | 'photos';
}

const { title, description, bodyClass = 'home', page = 'home' } = Astro.props;
const site = getSiteConfig();
const favicon = faviconInfo(site);

const pageTitle = cjkSpacing(
  title ? `${title} —— ${site.title}` : `${site.title} —— ${site.tagline}`
);
const pageDesc = description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={favicon.href} type={favicon.type} />
    {favicon.type !== 'image/svg+xml' && <link rel="apple-touch-icon" href={favicon.href} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL('/rss.xml', Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf9f5" />

    <script is:inline set:html={THEME_BOOT}></script>

    <!-- artifact 的全部样式，带内容指纹外链缓存 -->
    <link rel="stylesheet" href={`/artifact/artifact.css?v=${cssHash}`} />
  </head>

  <body class={bodyClass} data-page={page} data-scale="ultrawide">
    <slot />

    <!-- artifact 的全部行为，放在 slot 之后同步执行，保证元素与全局变量均已就绪 -->
    <script is:inline src={`/artifact/artifact.js?v=${jsHash}`}></script>

    <!-- 主页的滚动吸附（站点自己的行为，不写回 artifact 生成物） -->
    {page === 'home' && <script is:inline set:html={homeSnap}></script>}

    <!-- 轻量化真实访客信标（sendBeacon 异步非阻塞上报，过滤不执行 JS 的机房爬虫并补全 iPadOS/Win11 设备特征） -->
    <script is:inline set:html={TELEMETRY_BEACON}></script>
  </body>
</html>

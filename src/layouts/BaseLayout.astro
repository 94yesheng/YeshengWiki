---
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import { faviconInfo, getSiteConfig } from '../server/site';
import { copy, getPageValues } from '../server/pages';
import { cjkSpacing } from '../utils/typography';
import { THEME_BOOT } from '../utils/theme';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  masthead?: boolean;
}

const { title, description, bodyClass, masthead = true } = Astro.props;
const site = getSiteConfig();
const favicon = faviconInfo(site);
const pages = getPageValues();
const pageTitle = cjkSpacing(
  title ? `${title} —— ${site.title}` : `${site.title} —— ${site.tagline}`
);
const pageDesc = description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={favicon.href} type={favicon.type} />
    {favicon.type !== 'image/svg+xml' && <link rel="apple-touch-icon" href={favicon.href} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL('/rss.xml', Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf9f5" />

    <script is:inline set:html={THEME_BOOT}></script>
  </head>

  <body class={bodyClass}>
  <noscript><style>.infinity-loader{display:none!important}</style></noscript>
    <!-- 与文章子页一致的开屏动画（2026-10-18 统一） -->
    <div class="infinity-loader" id="infinity-loader" role="status" aria-live="polite" aria-label="正在加载页面">
      <canvas class="loader-infinity-canvas" id="loader-infinity-canvas"></canvas>
      <div class="loader-meta">
        <div class="loader-brand-emblem">
          <span class="loader-title-kai">{site.title}</span>
        </div>
        <span id="loader-status-text">{copy(pages, 'home.loader.status')}</span>
        <div class="loader-progress-row">
          <div class="loader-bar-track">
            <div class="loader-bar-fill" id="loader-bar-fill"></div>
          </div>
          <span class="loader-pct-readout" id="loader-pct-readout">0%</span>
        </div>
      </div>
    </div>

    <!-- 需求 8：结合无限与黑洞主题的昼夜切换过渡动画层 -->
    <div class="theme-transition-stage" id="theme-transition-stage" aria-hidden="true">
      <div class="theme-transition-veil" id="theme-transition-veil"></div>
      <canvas class="theme-transition-canvas" id="theme-transition-canvas"></canvas>
      <div class="theme-transition-badge" id="theme-transition-badge">SINGULARITY TRANSITION // ∞ ↔ BLACK HOLE</div>
    </div>

    <!-- 需求 6：子页背景简约平面无限（白天）/ 平面黑洞（黑夜）几何水印 -->
    <div class="subpage-planar-watermark" aria-hidden="true">
      <svg class="planar-icon planar-icon--infinity" viewBox="0 0 240 120">
        <circle cx="62" cy="60" r="46" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 4"/>
        <circle cx="178" cy="60" r="46" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 4"/>
        <path d="M91 31A41 41 0 1 0 91 89L149 31A41 41 0 1 1 149 89" fill="none" stroke="currentColor" stroke-width="3.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M91 31L106 46M134 74L149 89" fill="none" stroke="currentColor" stroke-width="3.8" stroke-linecap="butt"/>
        <path d="M102 52L112 42M128 78L138 68" fill="none" stroke="currentColor" stroke-width="1.6" stroke-opacity="0.55" stroke-linecap="round"/>
      </svg>
      <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 240 120">
        <circle cx="120" cy="60" r="50" fill="none" stroke="currentColor" stroke-width="0.7" stroke-dasharray="3 5"/>
        <path d="M52 54C72 8 168 8 188 54" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
        <path d="M64 68C84 104 156 104 176 68" fill="none" stroke="currentColor" stroke-width="1.15" stroke-opacity="0.78" stroke-linecap="round"/>
        <path d="M24 60A96 26 0 0 1 216 60" transform="rotate(-10 120 60)" fill="none" stroke="currentColor" stroke-width="1.15" stroke-opacity="0.45" stroke-dasharray="4 3"/>
        <circle cx="120" cy="60" r="22" fill="var(--paper)" stroke="currentColor" stroke-width="1.4"/>
        <circle cx="120" cy="60" r="15.5" fill="currentColor"/>
        <path d="M24 60A96 26 0 0 0 216 60" transform="rotate(-10 120 60)" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
    </div>

    <SiteHeader masthead={masthead} site={site} />
    <main>
      <slot />
    </main>
    <SiteFooter site={site} />
    <FloatingMenu />

    <script>
      import { initInfinityLoader } from '../utils/loader';
      initInfinityLoader({ durationMs: 1050 });
    </script>
  </body>
</html>

<style>
  :global(.site-foot-inner) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.38rem;
    flex-wrap: wrap;
    width: 100%;
  }
</style>

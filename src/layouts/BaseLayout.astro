---
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import { site } from '../site.config';
import { cjkSpacing } from '../utils/typography';

interface Props {
  /** 页面标题，会拼成「标题 —— 站名」 */
  title?: string;
  description?: string;
  /** 照片页那种深色画布，需要整屏铺底 */
  bodyClass?: string;
  /**
   * 要不要渲染站名 + 签名那块（`SiteHeader` 的下半段）。
   * 主页传 false —— 它把站名和签名放大成了自己的第一屏（hero），
   * 再渲染一遍就会出现两个 <h1>、同一个站名写两遍。顶栏不受影响，永远都在。
   */
  masthead?: boolean;
}

const { title, description, bodyClass, masthead = true } = Astro.props;

const pageTitle = cjkSpacing(
  title ? `${title} —— ${site.title}` : `${site.title} —— ${site.tagline}`
);
const pageDesc = description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL('/rss.xml', Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />

    <!-- 手机浏览器地址栏的颜色；下面的脚本会按最终主题改写它 -->
    <meta name="theme-color" content="#ffffff" />

    <!--
      夜间模式的"定调"脚本 —— **必须在首次绘制之前同步跑完**。

      为什么非得内联：Astro 打包出来的 <script> 是 type="module"，天然 defer，
      要等 HTML 解析完才执行 —— 那时候浅色已经画上去了，用 localStorage 切深色
      就会闪一下白（俗称 FOUC）。内联脚本在解析到这里时立刻执行，赶得上第一帧。

      这是全项目唯一一处 is:inline。它只做一件事：把"跟随系统还是用户已选"
      算成一个结果写进 <html data-theme>，CSS 那边就只需要认这一个值，
      不用在 @media (prefers-color-scheme) 里把整套深色再抄一遍。

      代价：禁用 JS 的访客永远是浅色（不做兜底媒体查询，那种重复不划算）。
    -->
    <script is:inline>
      (function () {
        var dark = false;
        try {
          var saved = localStorage.getItem('theme');
          dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
        } catch (e) {
          /* 隐私模式读 localStorage 会抛异常 —— 那样就退回浅色 */
        }
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#151412' : '#ffffff');
      })();
    </script>
  </head>

  <body class={bodyClass}>
    <SiteHeader masthead={masthead} />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <FloatingMenu />
  </body>
</html>

<style>
  /* 页脚是 flex 布局，里面再套一层 wrap 让它和正文对齐 */
  :global(.site-foot-inner) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    width: 100%;
  }
</style>

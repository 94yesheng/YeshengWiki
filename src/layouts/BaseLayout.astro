---
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import { faviconInfo, getSiteConfig } from '../server/site';
import { copy, getPageValues } from '../server/pages';
import { cjkSpacing } from '../utils/typography';
import { THEME_BOOT } from '../utils/theme';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  masthead?: boolean;
}

const { title, description, bodyClass, masthead = true } = Astro.props;
const site = getSiteConfig();
const favicon = faviconInfo(site);
const pages = getPageValues();
const pageTitle = cjkSpacing(
  title ? `${title} —— ${site.title}` : `${site.title} —— ${site.tagline}`
);
const pageDesc = description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={favicon.href} type={favicon.type} />
    {favicon.type !== 'image/svg+xml' && <link rel="apple-touch-icon" href={favicon.href} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL('/rss.xml', Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf9f5" />

    <script is:inline set:html={THEME_BOOT}></script>
  </head>

  <body class={bodyClass}>
  <noscript><style>.infinity-loader{display:none!important}</style></noscript>
    <!-- 与文章子页一致的开屏动画（2026-10-18 统一） -->
    <div class="infinity-loader" id="infinity-loader" role="status" aria-live="polite" aria-label="正在加载页面">
      <canvas class="loader-infinity-canvas" id="loader-infinity-canvas"></canvas>
      <div class="loader-meta">
        <div class="loader-brand-emblem">
          <span class="loader-title-kai">{site.title}</span>
        </div>
        <span id="loader-status-text">{copy(pages, 'home.loader.status')}</span>
        <div class="loader-progress-row">
          <div class="loader-bar-track">
            <div class="loader-bar-fill" id="loader-bar-fill"></div>
          </div>
          <span class="loader-pct-readout" id="loader-pct-readout">0%</span>
        </div>
      </div>
    </div>

    <!-- 需求 8：结合无限与黑洞主题的昼夜切换过渡动画层 -->
    <div class="theme-transition-stage" id="theme-transition-stage" aria-hidden="true">
      <div class="theme-transition-veil" id="theme-transition-veil"></div>
      <canvas class="theme-transition-canvas" id="theme-transition-canvas"></canvas>
      <div class="theme-transition-badge" id="theme-transition-badge">SINGULARITY TRANSITION // ∞ ↔ BLACK HOLE</div>
    </div>

    <!-- 需求 6：子页背景简约平面无限（白天）/ 平面黑洞（黑夜）几何水印 -->
    <div class="subpage-planar-watermark" aria-hidden="true">
      <svg class="planar-icon planar-icon--infinity" viewBox="0 0 240 120">
        <circle cx="62" cy="60" r="46" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 4"/>
        <circle cx="178" cy="60" r="46" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 4"/>
<path d="M91 31A41 41 0 1 0 91 89L149 31A41 41 0 1 1 149 89" fill="none" stroke="currentColor" stroke-width="3.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M91 31L106 46M134 74L149 89" fill="none" stroke="currentColor" stroke-width="3.8" stroke-linecap="butt"/>
        <path d="M102 52L112 42M128 78L138 68" fill="none" stroke="currentColor" stroke-width="1.6" stroke-opacity="0.55" stroke-linecap="round"/>
</svg>
      <svg class="planar-icon planar-icon--blackhole" viewBox="0 0 240 120">
        <circle cx="120" cy="60" r="50" fill="none" stroke="currentColor" stroke-width="0.7" stroke-dasharray="3 5"/>
        <path d="M52 54C72 8 168 8 188 54" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
        <path d="M64 68C84 104 156 104 176 68" fill="none" stroke="currentColor" stroke-width="1.15" stroke-opacity="0.78" stroke-linecap="round"/>
        <path d="M24 60A96 26 0 0 1 216 60" transform="rotate(-10 120 60)" fill="none" stroke="currentColor" stroke-width="1.15" stroke-opacity="0.45" stroke-dasharray="4 3"/>
        <circle cx="120" cy="60" r="22" fill="var(--paper)" stroke="currentColor" stroke-width="1.4"/>
        <circle cx="120" cy="60" r="15.5" fill="currentColor"/>
        <path d="M24 60A96 26 0 0 0 216 60" transform="rotate(-10 120 60)" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
    </div>

    <SiteHeader masthead={masthead} site={site} />
    <main>
      <slot />
    </main>
    <SiteFooter site={site} />
    <FloatingMenu />

    <script is:inline>
      (function () {
  /* ========================================================================
     需求 6：全新重构全屏沉浸式粒子立体无限流形加载动画
     ======================================================================== */
  var loaderEl = document.getElementById('infinity-loader');
  var loaderCanvas = document.getElementById('loader-infinity-canvas');
  var loaderFill = document.getElementById('loader-bar-fill');
  var loaderStatus = document.getElementById('loader-status-text');
  var loaderPct = document.getElementById('loader-pct-readout');
  var loaderAnimId = 0;
  var loaderStartTs = 0;
  var loaderActive = false;

  function runInfinityLoader(durationMs) {
    if (!loaderEl) return;
    cancelAnimationFrame(loaderAnimId);
    loaderEl.dataset.loaded = 'false';
    loaderActive = true;
    loaderStartTs = performance.now();
    var dur = durationMs || 1050;

    // 预生成 80 颗初始粒子：从中心奇点向外旋转绽放后收束至无限流形
    var loaderParticles = [];
    for (var k = 0; k < 80; k++) {
      var angle = Math.random() * Math.PI * 2;
      var dist = 30 + Math.random() * 260;
      loaderParticles.push({
        burstAngle: angle,
        burstDist: dist,
        burstSpeed: 0.8 + Math.random() * 1.4,
        loopU: Math.random() * Math.PI * 2,
        loopSpeed: 0.8 + Math.random() * 0.6,
        size: 1.2 + Math.random() * 2.2,
        color: k % 3 === 0 ? '217, 119, 87' : (k % 3 === 1 ? '232, 146, 110' : '245, 185, 135'),
        spread: (Math.random() - 0.5) * 16
      });
    }

    function stepLoader(now) {
      if (!loaderActive) return;
      var elapsed = now - loaderStartTs;
      var p = Math.min(1, elapsed / dur);
      var easeP = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;

      var pctVal = Math.round(p * 100);
      if (loaderFill) loaderFill.style.width = pctVal + '%';
      if (loaderPct) loaderPct.textContent = pctVal + '%';
      if (loaderStatus) {
        if (p < 0.3) {
          loaderStatus.textContent = 'QUANTUM GENESIS // 量子奇点初始化 (' + pctVal + '%)';
        } else if (p < 0.75) {
          loaderStatus.textContent = 'INFINITY MANIFOLD // 正在聚合立体纯粒子流形 (' + pctVal + '%)';
        } else if (p < 0.95) {
          loaderStatus.textContent = 'TOPOLOGY HARMONIC // 流形谐振对齐 (' + pctVal + '%)';
        } else {
          loaderStatus.textContent = 'MANIFOLD READY // 流形就绪 · 欢迎探索';
        }
      }

      if (loaderCanvas) {
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var w = Math.round(window.innerWidth * dpr);
        var h = Math.round(window.innerHeight * dpr);
        if (loaderCanvas.width !== w || loaderCanvas.height !== h) {
          loaderCanvas.width = w;
          loaderCanvas.height = h;
        }
        var lctx = loaderCanvas.getContext('2d');
        var W = w / dpr;
        var H = h / dpr;
        var cx = W * 0.5;
        var cy = H * 0.44;
        var minDim = Math.min(W, H);

        lctx.save();
        lctx.scale(dpr, dpr);
        lctx.clearRect(0, 0, W, H);

        // 1. 中心柔和光晕
        var glowR = minDim * (0.12 + 0.38 * easeP);
        var glowGrad = lctx.createRadialGradient(cx, cy, 0, cx, cy, glowR);
        glowGrad.addColorStop(0, 'rgba(217, 119, 87, ' + (0.32 * (1 - easeP * 0.4)).toFixed(3) + ')');
        glowGrad.addColorStop(0.5, 'rgba(232, 146, 110, ' + (0.12 * (1 - easeP * 0.4)).toFixed(3) + ')');
        glowGrad.addColorStop(1, 'rgba(217, 119, 87, 0)');
        lctx.fillStyle = glowGrad;
        lctx.fillRect(0, 0, W, H);

        // 2. 无限流形参数尺寸
        var a = Math.min(W * 0.36, minDim * 0.48);
        var b = a * 0.86;

        // 3. 当 p > 0.25 时，立体无限环轮廓主体线条平滑显现
        if (p > 0.25) {
          var lineAlpha = Math.min(1, (p - 0.25) / 0.45);
          lctx.save();
          lctx.beginPath();
          for (var s = 0; s <= 100; s++) {
            var tVal = (s / 100) * Math.PI * 2;
            var sinT = Math.sin(tVal), cosT = Math.cos(tVal);
            var den = 1 + sinT * sinT;
            var px = cx + (a * cosT) / den;
            var py = cy + (b * sinT * cosT) / den;
            if (s === 0) lctx.moveTo(px, py);
            else lctx.lineTo(px, py);
          }
          lctx.closePath();
          lctx.strokeStyle = 'rgba(217, 119, 87, ' + (0.38 * lineAlpha).toFixed(3) + ')';
          lctx.lineWidth = 1.4;
          lctx.stroke();

          // 左右双叶焦点光点
          var fx = a * 0.62;
          [-fx, fx].forEach(function (fxVal) {
            lctx.beginPath();
            lctx.arc(cx + fxVal, cy, 3.5, 0, Math.PI * 2);
            lctx.fillStyle = 'rgba(217, 119, 87, ' + (0.65 * lineAlpha).toFixed(3) + ')';
            lctx.fill();
          });
          lctx.restore();
        }

        // 4. 80 颗粒子绽放与收束过渡
        var convergeWeight = Math.max(0, Math.min(1, (p - 0.2) / 0.55));
        for (var i = 0; i < loaderParticles.length; i++) {
          var lp = loaderParticles[i];
          // 绽放形态下的坐标
          var burstR = lp.burstDist * easeP * lp.burstSpeed;
          var bx = cx + Math.cos(lp.burstAngle + elapsed * 0.001) * burstR;
          var by = cy + Math.sin(lp.burstAngle + elapsed * 0.001) * burstR * 0.75;

          // 无限流形形态下的坐标
          lp.loopU = (lp.loopU + lp.loopSpeed * 0.025) % (Math.PI * 2);
          var sinLu = Math.sin(lp.loopU), cosLu = Math.cos(lp.loopU);
          var denL = 1 + sinLu * sinLu;
          var ix = cx + (a * cosLu) / denL + Math.cos(lp.loopU * 2) * lp.spread;
          var iy = cy + (b * sinLu * cosLu) / denL + Math.sin(lp.loopU * 2) * lp.spread;

          // 平滑线性插值
          var curX = bx * (1 - convergeWeight) + ix * convergeWeight;
          var curY = by * (1 - convergeWeight) + iy * convergeWeight;
          var pAlpha = Math.min(0.95, 0.4 + 0.55 * Math.sin(p * Math.PI));

          if (lp.size > 2.0) {
            lctx.beginPath();
            lctx.arc(curX, curY, lp.size * 2.2, 0, Math.PI * 2);
            lctx.fillStyle = 'rgba(' + lp.color + ', ' + (pAlpha * 0.18).toFixed(3) + ')';
            lctx.fill();
          }

          lctx.beginPath();
          lctx.arc(curX, curY, lp.size, 0, Math.PI * 2);
          lctx.fillStyle = 'rgba(' + lp.color + ', ' + pAlpha.toFixed(3) + ')';
          lctx.fill();
        }

        // 5. 在 p > 0.82 时，中心向外扩散一道流形就绪完成光环
        if (p > 0.82) {
          var pulseP = (p - 0.82) / 0.18;
          var pulseR = minDim * 0.08 + pulseP * minDim * 0.45;
          lctx.save();
          lctx.beginPath();
          lctx.arc(cx, cy, pulseR, 0, Math.PI * 2);
          lctx.strokeStyle = 'rgba(232, 146, 110, ' + (0.5 * (1 - pulseP)).toFixed(3) + ')';
          lctx.lineWidth = 1.6;
          lctx.stroke();
          lctx.restore();
        }

        lctx.restore();
      }

      if (p < 1) {
        loaderAnimId = requestAnimationFrame(stepLoader);
      } else {
        loaderActive = false;
        loaderEl.dataset.loaded = 'true';
      }
    }

    loaderAnimId = requestAnimationFrame(stepLoader);
  }

  // 页面首次载入启动全屏粒子无限加载动画
  runInfinityLoader(1050);

  var btnReplayLoader = document.getElementById('btn-replay-loader');
  if (btnReplayLoader) {
    btnReplayLoader.addEventListener('click', function () {
      runInfinityLoader(1100);
    });
  }


      })();
    </script>
  </body>
</html>

<style>
  :global(.site-foot-inner) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.38rem;
    flex-wrap: wrap;
    width: 100%;
  }
</style>

---
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import { site } from '../site.config';
import { cjkSpacing } from '../utils/typography';
import { THEME_BOOT } from '../utils/theme';

interface Props {
  /** 页面标题，会拼成「标题 —— 站名」 */
  title?: string;
  description?: string;
  /** 照片页那种深色画布，需要整屏铺底 */
  bodyClass?: string;
  /**
   * 要不要渲染站名 + 签名那块（`SiteHeader` 的下半段）。
   * 主页传 false —— 它把站名和签名放大成了自己的第一屏（hero），
   * 再渲染一遍就会出现两个 <h1>、同一个站名写两遍。顶栏不受影响，永远都在。
   */
  masthead?: boolean;
}

const { title, description, bodyClass, masthead = true } = Astro.props;

const pageTitle = cjkSpacing(
  title ? `${title} —— ${site.title}` : `${site.title} —— ${site.tagline}`
);
const pageDesc = description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL('/rss.xml', Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />

    <!-- 手机浏览器地址栏的颜色；下面的脚本会按最终主题改写它 -->
    <meta name="theme-color" content="#faf9f5" />

    <!--
      夜间模式的"定调"脚本 —— **必须在首次绘制之前同步跑完**（否则会闪一下白，FOUC）。
      内容在 src/utils/theme.ts 的 THEME_BOOT 里，后台 /studio/ 用的是同一份 ——
      这里只负责把它内联出去。为什么不能 import、为什么要 set:html，见那个文件的注释。
    -->
    <script is:inline set:html={THEME_BOOT}></script>
  </head>

  <body class={bodyClass}>
    <SiteHeader masthead={masthead} />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <FloatingMenu />
  </body>
</html>

<style>
  /* 页脚是 flex 布局，里面再套一层 wrap 让它和正文对齐 */
  :global(.site-foot-inner) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    width: 100%;
  }
</style>
